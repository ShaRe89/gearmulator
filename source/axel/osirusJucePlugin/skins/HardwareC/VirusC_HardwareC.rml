  }
  local function HC8_Group02SetFrame(a, frame)
    if a.image ~= nil and frame ~= a.frame then
      a.image:SetAttribute("sprite", string.format("HC8_g02_press_%02d", frame))
      a.frame = frame
    end
  end
  local function HC8_Group02PressInit()
    for _, row in ipairs(HC8_Group02Press) do
      local a = row
      local button = document:GetElementById(a.button)
      a.image = document:GetElementById(a.imageId)
      a.held, a.phase, a.elapsed, a.frame = false, nil, 0, 1
      if button ~= nil and a.image ~= nil then
        button:AddEventListener("mousedown", function(event)
          if tonumber(event.parameters['button']) ~= 0 then return end
          a.held, a.phase, a.elapsed = true, "press", 0
          HC8_Group02SetFrame(a, 1)
        end)
      end
    end
    document:AddEventListener("mouseup", function(event)
      if tonumber(event.parameters['button']) ~= 0 then return end
      for _, a in ipairs(HC8_Group02Press) do
        if a.held then
          a.held, a.phase, a.elapsed = false, "release", 0
          HC8_Group02SetFrame(a, 7)
        end
      end
    end, true) -- Includes release outside the hitbox and the backend's off-window fallback.
  end
  local function HC8_Group02PressFrame(event)
    local delta = math.max(0, tonumber(event.parameters['delta']) or 0)
    for _, a in ipairs(HC8_Group02Press) do
      if a.phase ~= nil then
        a.elapsed = math.min(0.100, a.elapsed + delta)
        local step = math.min(5, math.floor(a.elapsed * 60))
        HC8_Group02SetFrame(a, (a.phase == "press" and 1 or 7) + step)
        if a.elapsed >= 0.100 then a.phase = nil end
      end
    end
  end
