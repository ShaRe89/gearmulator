<rml>
	<head>
		<link type="text/template" href="tus_colorpicker.rml"/>
		<link type="text/template" href="tus_patchmanager.rml"/>
		<link type="text/rcss" href="tus_default.rcss"/>
		<link type="text/rcss" href="tus_juceskin.rcss"/>
		<link type="text/rcss" href="VirusC_HardwareC.rcss"/>
	<!-- HC_FILTER_SCRIPT_BEGIN -->
<script>
  -- v1: preserve the 4 conventional modes (LP, HP, BP, BS).
  -- Filter1 additionally has analog modes 4-7; those light none of these 4 LEDs.
  function HC_Filter_Update(which, rawValue)
    local val = tonumber(rawValue)
    if val == nil then return end
    local modes = {"LP", "HP", "BP", "BS"}
    for index = 1, 4 do
      local led = document:GetElementById("HC_Filter" .. which .. "_" .. modes[index])
      if led ~= nil then
        led.style.opacity = (val == index - 1) and "1" or "0"
      end
    end
  end

  function HC_Filter_Cycle(which)
    local parameter = (which == 1) and "Filter1 Mode" or "Filter2 Mode"
    local oldValue = tonumber(params.get(parameter))
    if oldValue == nil then return end
    -- First pass: only LP/HP/BP/BS, matching the four marked LEDs.
    params.set(parameter, (oldValue + 1) % 4)
  end

  function HC_Filter_Init()
    HC_Filter_Update(1, params.get("Filter1 Mode"))
    HC_Filter_Update(2, params.get("Filter2 Mode"))
    params.onChange("Filter1 Mode", function(value)
      HC_Filter_Update(1, value)
    end)
    params.onChange("Filter2 Mode", function(value)
      HC_Filter_Update(2, value)
    end)
  end
</script>
<!-- HC_FILTER_SCRIPT_END -->
<!-- HC_OSCLFO_SCRIPT_BEGIN -->
<script>
  -- UI-only selection state: the Virus C oscillator/LFO panel buttons select
  -- which group the physical controls address. Dynamic re-binding of the
  -- shared knobs is NOT in this patch.
  HC_OL_osc = 1
  HC_OL_lfo = 1
  HC_OL_lastOsc3Mode = 1

  function HC_OL_Led(name, on)
    local element = document:GetElementById("HC_OL_" .. name)
    if element ~= nil then element.style.opacity = on and "1" or "0" end
  end

  function HC_OL_SelectOsc(which)
    HC_OL_osc = which
    for k=1,3 do HC_OL_Led("OscSel" .. k, k == which) end
  end

  function HC_OL_SelectLfo(which, readOnly)
    HC_OL_lfo = which
    -- B126 manual selection: LFO1=0, LFO2=1, LFO3=2, MOD=3.
    if not readOnly and which >= 1 and which <= 4 then
      params.set("B_Undefined126", which - 1)
    end
    for k=1,4 do HC_OL_Led("LfoSel" .. k, k == which) end
    HC_OL_RefreshShape()
    if HC6_Mode == "menu" and HC6_Group == "LFO SHAPE" then HC6_ShowLfoShape() end
  end

  function HC_OL_NextLfo()
    HC_OL_SelectLfo((HC_OL_lfo % 4) + 1)
  end

  function HC_OL_RefreshShape()
    local v = nil
    if HC_OL_lfo ~= 4 then v = tonumber(params.get("Lfo" .. HC_OL_lfo .. " Shape")) end
    -- Shape codes 0=sine 1=triangle 2=saw 3=square.
    -- 4/5 are random waveforms; >=6 are extended cyclic waveforms.
    local names={"LfoSine","LfoTri","LfoSaw","LfoRect","LfoWave"}
    for k=1,5 do
      local active = (v ~= nil) and ((k <= 4 and v == k-1) or (k == 5 and v >= 4))
      HC_OL_Led(names[k],active)
    end
  end

  function HC_OL_NextLfoShape()
    if HC_OL_lfo == 4 then return end  -- MOD matrix has no LFO waveform
    local p = "Lfo" .. HC_OL_lfo .. " Shape"
    local v = tonumber(params.get(p))
    if v == nil then return end
    params.set(p, v >= 4 and 0 or v + 1)
    HC6_ShowLfoShape()
  end

  function HC_OL_RefreshOsc3(raw)
    local v=tonumber(raw)
    if v==nil then return end
    if v>0 then HC_OL_lastOsc3Mode=v end
    HC_OL_Led("Osc3On",v>0)
  end

  function HC_OL_ToggleOsc3()
    local v=tonumber(params.get("Osc3 Mode"))
    if v==nil then return end
    if v>0 then
      HC_OL_lastOsc3Mode=v
      params.set("Osc3 Mode",0)
    else
      params.set("Osc3 Mode",HC_OL_lastOsc3Mode)
    end
  end

  function HC_OL_RefreshSync(raw)
    local v=tonumber(raw)
    if v ~= nil then HC_OL_Led("OscSync",v ~= 0) end
  end

  function HC_OL_ToggleSync()
    local v=tonumber(params.get("Osc2 Sync"))
    if v~=nil then params.set("Osc2 Sync",v==0 and 1 or 0) end
  end


  -- ARP On/Off is a real firmware parameter. Preserve a previously selected mode.
  HC_B_lastArpMode = 1
  HC_B_fxSelected = 1
  function HC_B_Led(name, enabled)
    local e = document:GetElementById("HC_B_" .. name)
    if e ~= nil then e.style.opacity = enabled and "1" or "0" end
  end
  function HC_B_RefreshArp(v)
    local n = tonumber(v)
    if n == nil then return end
    if n > 0 then HC_B_lastArpMode = n end
    HC_B_Led("ArpOn", n > 0)
  end
  function HC_B_ToggleArp()
    local n = tonumber(params.get("Arp Mode"))
    if n == nil then return end
    if n > 0 then
      HC_B_lastArpMode = n
      params.set("Arp Mode", 0)
    else
      params.set("Arp Mode", HC_B_lastArpMode)
    end
  end
  -- Effect SELECT is editor selection only; effect DSP routing isn't changed.
  function HC_B_SelectFx(which)
    HC_B_fxSelected = which
    HC_B_Led("FxDist", which == 1)
    HC_B_Led("FxPha", which == 2)
    HC_B_Led("FxCho", which == 3)
  end
  function HC_B_NextFx()
    HC_B_SelectFx((HC_B_fxSelected % 3) + 1)
    HC6_EffectsOrigin = HC6_Mode == "menu" and HC6_Group == "EFFECTS"
      and ({[2]=7, [3]=8})[HC_B_fxSelected] or nil
    if HC6_Mode == "menu" and HC6_Group == "EFFECTS" then
      HC6_Index = ({1, 11, 17})[HC_B_fxSelected]
      HC6_BindSelected()
      HC6_Draw()
    end
  end
  function HC_B_Init()
    HC_B_RefreshArp(params.get("Arp Mode"))
    params.onChange("Arp Mode", function(v) HC_B_RefreshArp(v) end)
    HC_B_SelectFx(1)
  end

  function HC_OL_Init()
    HC_B_Init()
    HC_OL_SelectOsc(1)
    HC_OL_SelectLfo(1, true)
    HC_OL_RefreshOsc3(params.get("Osc3 Mode"))
    HC_OL_RefreshSync(params.get("Osc2 Sync"))
    params.onChange("Osc3 Mode",function(v) HC_OL_RefreshOsc3(v) end)
    params.onChange("Osc2 Sync",function(v) HC_OL_RefreshSync(v) end)
    for k=1,3 do
      params.onChange("Lfo" .. k .. " Shape",function(v) HC_OL_RefreshShape() end)
    end
    params.onPartChanged(function(part)
      if part ~= params.getCurrentPart() then return end
      if HC_OL_lfo == 2 or HC_OL_lfo == 3 then HC_OL_SelectLfo(HC_OL_lfo, true) end
    end)
  end
</script>
<!-- HC_OSCLFO_SCRIPT_END -->
<!-- HC4_SCRIPT_BEGIN -->
<script>
  -- Safe v4 addition. Never relocate/duplicate native Osirus controls.
  -- All clickable areas are ordinary RmlUi divs, with valid inline Lua.
  HC_R_edit = {}
  HC_R_filter = 1
  HC_R_bank = 1
  HC_R_lastParam = "Cutoff"
  HC_R_undo = nil
  HC_R_assignSlot = 1
  HC_R_choices = {
    "Cutoff", "Filter1 Resonance", "Cutoff2", "Filter2 Resonance",
    "Osc1 Shape", "Osc2 Detune", "Osc2 FM Amount", "Lfo1 Rate",
    "Lfo2 Rate", "Lfo3 Rate", "Arp Mode", "Delay/Reverb Mode"
  }

  function HC_R_SetLed(number, enabled)
    local e = document:GetElementById(string.format("HC_R_LED_%04d", number))
    if e ~= nil then e.style.opacity = enabled and "1" or "0" end
  end
  function HC_R_ToggleEdit(group, led)
    HC_R_edit[group] = not HC_R_edit[group]
    HC_R_SetLed(led, HC_R_edit[group])
  end
  function HC_R_ChooseParam(name)
    if params.getInfo(name) ~= nil then HC_R_lastParam = name end
  end
  function HC_R_Value(delta)
    local p = HC_R_lastParam
    local info = params.getInfo(p)
    if not info then return end
    local v,lo,hi = tonumber(params.get(p)),tonumber(info.min),tonumber(info.max)
    if not v or not lo or not hi then return end
    params.set(p, math.max(lo,math.min(hi,v+delta)))
  end
  function HC_R_Bank(delta)
    HC_R_bank = ((HC_R_bank-1+delta) % #HC_R_choices)+1
    HC_R_ChooseParam(HC_R_choices[HC_R_bank])
  end
  function HC_R_Transpose(direction)
    -- Virus C Transpose parameter is signed MIDI byte (center 64).
    local p = "Transpose"
    local v = tonumber(params.get(p))
    local info = params.getInfo(p)
    if not v or not info then return end
    params.set(p,math.max(info.min,math.min(info.max,v+12*direction)))
    HC_R_ChooseParam(p)
  end
  function HC_R_ShowTranspose(raw)
    local v=tonumber(raw)
    if not v then return end
    local octave=math.max(-2,math.min(2,math.floor((v-64)/12+0.5)))
    for i=-2,2 do HC_R_SetLed(73+i,i==octave) end
  end
  function HC_R_Randomize()
    -- Limited six-parameter variation only; not hardware RANDOM.
    local names={"Osc1 Shape","Osc2 Detune","Cutoff","Filter1 Resonance","Lfo1 Rate","Osc2 FM Amount"}
    local saved={}
    for _,p in ipairs(names) do
      local info=params.getInfo(p)
      if info then
        local v=tonumber(params.get(p))
        local lo,hi=tonumber(info.min),tonumber(info.max)
        if v and lo and hi and hi>=lo then
          saved[p]=v
          local span=hi-lo
          local change=math.floor((math.random()*2-1)*span*0.15+0.5)
          params.set(p,math.max(lo,math.min(hi,v+change)))
        end
      end
    end
    HC_R_undo=saved
  end
  function HC_R_Undo()
    if HC_R_undo == nil then return end
    for p,v in pairs(HC_R_undo) do params.set(p,v) end
    HC_R_undo=nil
  end
  function HC_R_SelectFilter(which)
    HC_R_filter=which
    HC_R_SetLed(126,which==2)
    HC_R_SetLed(127,which==1)
    HC_R_ChooseParam(which==1 and "Filter1 Mode" or "Filter2 Mode")
    if HC6_Mode == "menu" and HC6_Group == "FILTER" then
      HC6_Index = HC6_FilterStartIndex()
      HC6_ActiveKnob = nil
      HC6_BindSelected()
      HC6_Draw()
    end
  end
  -- The MOD ASSIGN 1..6 LEDs are local editing selection, not DSP state.
  function HC_R_ShowAssign()
    for i=1,6 do HC_R_SetLed(36+i,i==HC_R_assignSlot) end
  end
  function HC_R_NextLfoDestination()
    local selected=HC_OL_lfo or 1
    if selected==1 then
      if HC6_Mode=="menu" and HC6_Group=="LFO1 SELECT" then
        HC6_Index=(HC6_Index % 8)+1
        HC6_BindSelected()
        HC6_Draw()
      else
        HC6_OpenMenu("LFO1 SELECT")
      end
      return
    end
    local group=({[2]="LFO2 SELECT",[3]="LFO3 SELECT",[4]="MOD SELECT"})[selected]
    if group==nil then return end
    if HC6_Mode=="menu" and HC6_Group==group then
      HC6_Index=(HC6_Index % #HC6_Menus[group])+1
      HC6_BindSelected()
      HC6_Draw()
    else
      HC6_OpenMenu(group)
    end
  end
  -- Fixed LFO modulation amount LEDs: centered bipolar values have neutral 64.
  HC_R_amounts={
    {20,"Osc1 Lfo1 Amount"},{21,"Osc2 Lfo1 Amount"},{22,"PW Lfo1 Amount"},
    {23,"Reso Lfo1 Amount"},{24,"FiltGain Lfo1 Amount"},
    {26,"Cutoff1 Lfo2 Amount"},{27,"Cutoff2 Lfo2 Amount"},
    {28,"Shape Lfo2 Amount"},{29,"FM Lfo2 Amount"},{30,"Pan Lfo2 Amount"}
  }
  function HC_R_Lfo1SelectLed(index)
    if HC_OL_lfo~=1 or HC6_Mode~="menu" or HC6_Group~="LFO1 SELECT" then return nil end
    if index<20 or index>25 then return nil end
    local page=HC6_Index
    return (index==20 and (page==1 or page==2))
      or (index==21 and (page==2 or page==3))
      or (index==22 and page==4) or (index==23 and page==5)
      or (index==24 and page==6) or (index==25 and (page==7 or page==8))
  end
  function HC_R_ShowAmount(index,raw)
    local selected=HC_R_Lfo1SelectLed(index)
    if selected==nil then selected=HC_R_Lfo2SelectLed(index) end
    if selected~=nil then HC_R_SetLed(index,selected); return end
    local v=tonumber(raw)
    HC_R_SetLed(index,v~=nil and v~=64)
  end
  function HC_R_ShowAssignAmount(index,dest,amount)
    local selected=HC_R_Lfo1SelectLed(index)
    if selected==nil then selected=HC_R_Lfo2SelectLed(index) end
    if selected~=nil then HC_R_SetLed(index,selected); return end
    local d,a=tonumber(dest),tonumber(amount)
    HC_R_SetLed(index,d~=nil and a~=nil and d~=0 and a~=64)
  end
  function HC_R_Lfo2SelectLed(index)
    if HC_OL_lfo~=2 or HC6_Mode~="menu" or HC6_Group~="LFO2 SELECT" then return nil end
    if index<26 or index>31 then return nil end
    local page=HC6_Index
    return (index==26 and (page==1 or page==2))
      or (index==27 and (page==2 or page==3))
      or (index==28 and page==4) or (index==29 and page==5)
      or (index==30 and page==6) or (index==31 and (page==7 or page==8))
  end
  -- SYNC PHASE is a selection page only; no parameter binding is available.
  function HC_R_ShowLfo3(raw)
    if HC_OL_lfo==3 and HC6_Mode=="menu" and HC6_Group=="LFO3 SELECT" then
      local page=HC6_Index
      HC_R_SetLed(32,page==1 or page==2)
      HC_R_SetLed(33,page==2 or page==3)
      HC_R_SetLed(34,page==4 or page==5)
      HC_R_SetLed(35,page==5 or page==6)
      HC_R_SetLed(36,page==7)
      return
    end
    HC_R_SetLed(36,false)
    local v=tonumber(raw)
    HC_R_SetLed(32,v==0 or v==1)
    HC_R_SetLed(33,v==1 or v==2)
    HC_R_SetLed(34,v==3 or v==4)
    HC_R_SetLed(35,v==4 or v==5)
  end
  function HC_R_Init()
    HC_R_SelectFilter(1)
    HC_R_ShowAssign()
    HC_R_ShowTranspose(params.get("Transpose"))
    for _,row in ipairs(HC_R_amounts) do
      local idx,p=row[1],row[2]
      HC_R_ShowAmount(idx,params.get(p))
      params.onChange(p,function(value) HC_R_ShowAmount(idx,value) end)
    end
    HC_R_ShowAssignAmount(25,params.get("LFO1 Assign Dest"),params.get("LFO1 Assign Amount"))
    HC_R_ShowAssignAmount(31,params.get("LFO2 Assign Dest"),params.get("LFO2 Assign Amount"))
    local function refresh1() HC_R_ShowAssignAmount(25,params.get("LFO1 Assign Dest"),params.get("LFO1 Assign Amount")) end
    local function refresh2() HC_R_ShowAssignAmount(31,params.get("LFO2 Assign Dest"),params.get("LFO2 Assign Amount")) end
    params.onChange("LFO1 Assign Dest",refresh1)
    params.onChange("LFO1 Assign Amount",refresh1)
    params.onChange("LFO2 Assign Dest",refresh2)
    params.onChange("LFO2 Assign Amount",refresh2)
    HC_R_ShowLfo3(params.get("Lfo3 Destination"))
    params.onChange("Lfo3 Destination",function(v) HC_R_ShowLfo3(v) end)
    params.onChange("Transpose",function(v) HC_R_ShowTranspose(v) end)
    -- LEDs 36 / 76 / 77 left off because these native states lack
    -- a reliable firmware-to-LED mapping via this Lua layer.
  end
</script>
<!-- HC4_SCRIPT_END -->


<!-- HC5_SCRIPT_BEGIN -->
<script>
  -- v5: change only visibility of ordinary, independently parameter-bound knobs.
  -- No native Osirus control is relocated, reparented or dynamically rebound.
  function HC5_ShowContext()
    local osc = tonumber(HC_OL_osc) or 1
    local lfo = tonumber(HC_OL_lfo) or 1
    local fx = tonumber(HC_B_fxSelected) or 1
    local revMode = tonumber(params.get("Delay/Reverb Mode")) or 0
    local delay = (revMode >= 2 and revMode <= 4) and 2 or 1
    for _,row in ipairs(HC5_Groups) do
      local id,group,variant = row[1],row[2],row[3]
      local show = group == "always"
        or (group == "osc" and variant == osc)
        or (group == "detune" and variant == (osc == 3 and 3 or 1))
        or (group == "lfo" and variant == lfo)
        or (group == "fx" and variant == fx)
        or (group == "delay" and variant == delay)
      local e = document:GetElementById(id)
      if e ~= nil then
        if id == "HardwareMap_ctrl_0091" then
          -- Reuse the OSC1 SHAPE graphic for OSC3, without accepting input.
          show = osc ~= 2
          e.style["pointer-events"] = osc == 3 and "none" or "auto"
        end
        if group == "lfo" then
          if lfo == 4 then show = e.style.display ~= "none" end
          e.style["pointer-events"] = lfo == 4 and "none" or "auto"
        end
        e.style.display = show and "block" or "none"
      end
    end
  end
  HC5_Groups = {
    {"HC5_K_0011_1", "lfo", 1},
    {"HC5_K_0011_2", "lfo", 2},
    {"HC5_K_0011_3", "lfo", 3},
    {"HC5_K_0054_1", "fx", 1},
    {"HC5_K_0054_2", "fx", 2},
    {"HC5_K_0054_3", "fx", 3},
    {"HC5_K_0055_1", "fx", 1},
    {"HC5_K_0055_2", "fx", 2},
    {"HC5_K_0055_3", "fx", 3},
    {"HC5_K_0056_1", "always", 1},
    {"HC5_K_0057_1", "delay", 1},
    {"HC5_K_0057_2", "delay", 2},
    {"HC5_K_0058_1", "delay", 1},
    {"HC5_K_0058_2", "delay", 2},
    {"HC5_K_0078_1", "always", 1},
    {"HC5_K_0079_1", "always", 1},
    {"HardwareMap_ctrl_0091", "osc", 1},
    {"HC5_K_0091_2", "osc", 2},
    {"HC5_K_0092_1", "osc", 1},
    {"HC5_K_0092_2", "osc", 2},
    {"HC5_K_0092_3", "osc", 3},
    {"HardwareMap_ctrl_0093", "osc", 1},
    {"HC5_K_0093_2", "osc", 2},
    {"HC5_K_0093_3", "osc", 3},
    {"HC5_K_0094_1", "detune", 1},
    {"HC5_K_0094_3", "detune", 3}
  }
  -- Visual ARP press/release only; the existing click owns all parameter changes.
  local HC8_ArpPress = {held=false, phase=nil, elapsed=0, frame=1, image=nil}
  local function HC8_ArpSetFrame(frame)
    local a = HC8_ArpPress
    if a.image ~= nil and frame ~= a.frame then
      a.image:SetAttribute("sprite", string.format("HC8_arp_press_%02d", frame))
      a.frame = frame
    end
  end
  local function HC8_ArpPressInit()
    local button = document:GetElementById("HC_B_BtnArpOn")
    local a = HC8_ArpPress
    a.image = document:GetElementById("HC8_ArpPressImage")
    if button == nil or a.image == nil then return end
    button:AddEventListener("mousedown", function(event)
      if tonumber(event.parameters['button']) ~= 0 then return end
      a.held, a.phase, a.elapsed = true, "press", 0
      HC8_ArpSetFrame(1)
    end)
    -- Capture release anywhere, including the backend's off-window mouseup fallback.
    -- Observe only: do not stop propagation or synthesize a click.
    document:AddEventListener("mouseup", function(event)
      if tonumber(event.parameters['button']) ~= 0 or not a.held then return end
      a.held, a.phase, a.elapsed = false, "release", 0
      HC8_ArpSetFrame(7)
    end, true)
  end
  local function HC8_ArpPressFrame(event)
    local a = HC8_ArpPress
    if a.phase == nil then return end
    local delta = math.max(0, tonumber(event.parameters['delta']) or 0)
    a.elapsed = math.min(0.100, a.elapsed + delta)
    local step = math.min(5, math.floor(a.elapsed * 60))
    HC8_ArpSetFrame((a.phase == "press" and 1 or 7) + step)
    if a.elapsed >= 0.100 then a.phase = nil end -- Hold 6, or rest at 12.
  end
  -- HC8_GROUP01_PRESS_BEGIN: independent visual states; original ARP ON stays unchanged.
  local HC8_Group01Press = {
    {button="HC_R_BTN_0043", imageId="HC8_G01_ArpEdit"},
    {button="HC_R_BTN_0046", imageId="HC8_G01_FxEdit"},
    {button="HC_B_BtnFxSelect", imageId="HC8_G01_FxSelect"},
    {button="HC_R_BTN_0048", imageId="HC8_G01_DelayEdit"},
    {button="HC_R_BTN_0003", imageId="HC8_G01_LfoEdit"},
    {button="HC_OL_BtnLfoSelect", imageId="HC8_G01_LfoSelect"},
    {button="HC_R_BTN_0045", imageId="HC8_G01_LfoDestinationSelect"}
  }
  local function HC8_Group01SetFrame(a, frame)
    if a.image ~= nil and frame ~= a.frame then
      a.image:SetAttribute("sprite", string.format("HC8_arp_press_%02d", frame))
      a.frame = frame
    end
  end
  local function HC8_Group01PressInit()
    for _, row in ipairs(HC8_Group01Press) do
      local a = row -- Each listener retains its own button state.
      local button = document:GetElementById(a.button)
      a.image = document:GetElementById(a.imageId)
      a.held, a.phase, a.elapsed, a.frame = false, nil, 0, 1
      if button ~= nil and a.image ~= nil then
        button:AddEventListener("mousedown", function(event)
          if tonumber(event.parameters['button']) ~= 0 then return end
          a.held, a.phase, a.elapsed = true, "press", 0
          HC8_Group01SetFrame(a, 1)
        end)
      end
    end
    document:AddEventListener("mouseup", function(event)
      if tonumber(event.parameters['button']) ~= 0 then return end
      for _, a in ipairs(HC8_Group01Press) do
        if a.held then
          a.held, a.phase, a.elapsed = false, "release", 0
          HC8_Group01SetFrame(a, 7)
        end
      end
    end, true) -- Observe releases outside the hitbox without consuming the click.
  end
  local function HC8_Group01PressFrame(event)
    local delta = math.max(0, tonumber(event.parameters['delta']) or 0)
    for _, a in ipairs(HC8_Group01Press) do
      if a.phase ~= nil then
        a.elapsed = math.min(0.100, a.elapsed + delta)
        local step = math.min(5, math.floor(a.elapsed * 60))
        HC8_Group01SetFrame(a, (a.phase == "press" and 1 or 7) + step)
        if a.elapsed >= 0.100 then a.phase = nil end
      end
    end
  end
  -- HC8_GROUP01_PRESS_END
  -- HC8_GROUP02_PRESS_BEGIN: visual animation only; no parameter or click changes.
  local HC8_Group02Press = {
