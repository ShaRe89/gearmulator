		<button id="SelectPart" class="jucePos juceButton preset-selected-light-74x68" isToggle="1" style="left: 62dp; top: 468dp; width: 74dp; height: 68dp;"/>
		<img id="PartActive" class="jucePos" src="part_activity.png" style="left: 62dp; top: 468dp; width: 74dp; height: 68dp;"/>
