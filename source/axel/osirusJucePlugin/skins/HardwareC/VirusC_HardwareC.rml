  -- HC8_MODE_PRESS_END
  function HC5_SelectDiagSnapshot()
    local e = document:GetElementById("HC5_SelectDiag")
    if e == nil then return end
    local part = params.getCurrentPart()
    local b127 = params.get("B_Undefined127")
    local b125 = params.get("B_Undefined125")
    e.inner_rml = "Part=" .. tostring(part) .. " B127=" .. tostring(b127)
      .. " B125=" .. tostring(b125) .. " OSC=" .. tostring(HC_OL_osc)
      .. " FX=" .. tostring(HC_B_fxSelected)
  end
  function HC5_Init()
    -- Preserve v2/v4 selector behavior; add only contextual knob visibility.
    local oldOsc = HC_OL_SelectOsc
    HC_OL_SelectOsc = function(n)
      oldOsc(n)
      HC5_ShowContext()
      if HC6_Mode == "menu" and HC6_Group == "OSC" then
        HC6_Index = HC6_OscStartIndex()
        HC6_ActiveKnob = nil
        HC6_BindSelected()
        HC6_Draw()
      end
    end
    local oldLfo = HC_OL_SelectLfo
    HC_OL_SelectLfo = function(n, readOnly)
      oldLfo(n, readOnly)
      HC5_ShowContext()
      if not readOnly and HC6_Mode == "menu" and (HC6_Group == "LFO" or HC6_Group == "MOD EDIT") then
        if n == 4 then
          HC6_OpenMenu("MOD EDIT")
        elseif n >= 1 and n <= 3 then
          HC6_OpenMenu("LFO")
        end
      end
    end
    local oldFx = HC_B_SelectFx
    HC_B_SelectFx = function(n)
      oldFx(n)
      HC5_ShowContext()
    end
    params.onChange("Delay/Reverb Mode", function() HC5_ShowContext() end)
    HC5_ShowContext()
    HC8_ArpPressInit()
    HC8_Group01PressInit()
    HC8_Group02PressInit()
    HC8_Group03PressInit()
    HC8_Group04PressInit()
    HC8_Group05PressInit()
    HC8_ModePressInit()
  end
  -- Copy native LED brightness from hidden sources without remapping.
  function HC5_Frame(event)
    HC8_ArpPressFrame(event)
    HC8_Group01PressFrame(event)
    HC8_Group02PressFrame(event)
    HC8_Group03PressFrame(event)
    HC8_Group04PressFrame(event)
    HC8_Group05PressFrame(event)
    HC8_ModePressFrame(event)
    local names = {"Lfo1LedOn", "Lfo2LedOn"}
    local ids = {"HC_R_LED_0009", "HC_R_LED_0010"}
    for i=1,2 do
      local source = document:GetElementById(names[i])
      local e = document:GetElementById(ids[i])
      if source ~= nil and e ~= nil then
        e.style.opacity = source.style.opacity
      end
    end
  end
</script>
<!-- HC5_SCRIPT_END -->

<!-- HC6_LCD_SCRIPT_BEGIN -->
<script>
  -- Virus C hardware-panel LCD: editor menu backed by real Osirus parameters.
  -- This is not a firmware display framebuffer or firmware menu protocol.
HC6_Menus = {
  ["LFO1 SELECT"] = {"Osc1 Lfo1 Amount", "Osc1 Lfo1 Amount", "Osc2 Lfo1 Amount", "PW Lfo1 Amount", "Reso Lfo1 Amount", "FiltGain Lfo1 Amount", "LFO1 Assign Dest", "LFO1 Assign Amount"},
  ["LFO2 SELECT"] = {"Cutoff1 Lfo2 Amount", "Cutoff1 Lfo2 Amount", "Cutoff2 Lfo2 Amount", "Shape Lfo2 Amount", "FM Lfo2 Amount", "Pan Lfo2 Amount", "LFO2 Assign Dest", "LFO2 Assign Amount"},
  ["LFO3 SELECT"] = {"Osc Lfo3 Amount", "Osc Lfo3 Amount", "Osc Lfo3 Amount", "Osc Lfo3 Amount", "Osc Lfo3 Amount", "Osc Lfo3 Amount", ""},
  ["MOD SELECT"] = {"Assign1 Source", "Assign1 Destination", "Assign1 Amount", "Assign2 Source", "Assign2 Destination1", "Assign2 Amount1", "Assign2 Destination2", "Assign2 Amount2", "Assign3 Source", "Assign3 Destination1", "Assign3 Amount1", "Assign3 Destination2", "Assign3 Amount2", "Assign3 Destination3", "Assign3 Amount3", "Assign 4 Source", "Assign 4 Destination", "Assign 4 Amount", "Assign 5 Source", "Assign 5 Destination", "Assign 5 Amount", "Assign 6 Source", "Assign 6 Destination", "Assign 6 Amount"},
  ["PATCH"] = {"Unison Detune", "Unison Pan Spread", "Unison Lfo Phase", "Unison Mode", "Portamento Time", "PulseWidth Velocity", "Transpose", "Bender Range Up", "Bender Range Down", "Bender Scale", "Category1", "Category2"},
  ["OSC"] = {"Osc1 Shape", "Osc1 Pulsewidth", "Osc1 Semitone", "Osc1 Keyfollow", "Osc2 Shape", "Osc2 Pulsewidth", "Osc2 Semitone", "Osc2 Keyfollow", "Osc2 FM Amount", "Osc2 Detune", "FM Filt Env Amt", "Osc2 Filt Env Amt", "Osc3 Semitone", "Osc3 Detune", "Osc3 Volume", "Osc Init Phase", "Osc1 Wave Select", "Osc2 Wave Select", "Osc FM Mode", "Osc3 Mode", "Osc2 Sync", "Osc Balance", "Osc Mainvolume", "Noise Volume", "Ringmodulator Volume", "Noise Color", "Suboscillator Volume", "Suboscillator Shape", "Osc1 Shape Velocity", "Osc2 Shape Velocity", "Fm Amount Velocity"},
  ["FILTER"] = {"Cutoff", "Filter1 Resonance", "Filter1 Env Amt", "Filter1 Keyfollow", "Resonance1 Velocity", "Flt1 EnvAmt Velocity", "Filter1 Mode", "Filter1 Env Polarity", "Cutoff2", "Cutoff2Offset", "Filter2 Resonance", "Filter2 Env Amt", "Filter2 Keyfollow", "Resonance2 Velocity", "Flt2 EnvAmt Velocity", "Filter2 Mode", "Filter2 Env Polarity", "Filter Balance", "Filter Routing", "Saturation Curve", "Filter Keytrack Base", "Filter2 Cutoff Link", "Filter Select", "Filter Env Attack", "Filter Env Decay", "Filter Env Sustain", "Filter Env Sustain Time", "Filter Env Release", "Amp Env Sustain Time"},
  ["AMP"] = {"Amp Env Attack", "Amp Env Decay", "Amp Env Sustain", "Amp Env Sustain Time", "Amp Env Release", "Punch Intensity", "Amp Velocity", "Panorama Velocity", "Patch Volume", "Panorama"},
  ["LFO"] = {"Lfo1 Shape", "Lfo1 Clock", "Lfo1 Mode", "Lfo1 Env Mode", "Lfo1 Rate", "Lfo1 Keyfollow", "Lfo1 Symmetry", "Lfo1 Keytrigger", "Lfo2 Shape", "Lfo2 Clock", "Lfo2 Mode", "Lfo2 Env Mode", "Lfo2 Rate", "Lfo2 Keyfollow", "Lfo2 Symmetry", "Lfo2 Keytrigger", "Lfo3 Shape", "Lfo3 Clock", "Lfo3 Mode", "Lfo3 Rate", "Lfo3 Keyfollow", "Lfo3 Fade-In Time", "Lfo3 Destination"},
  ["MOD MATRIX"] = {"Osc1 Lfo1 Amount", "Osc2 Lfo1 Amount", "FiltGain Lfo1 Amount", "LFO1 Assign Amount", "PW Lfo1 Amount", "Reso Lfo1 Amount", "LFO1 Assign Dest", "Cutoff1 Lfo2 Amount", "Cutoff2 Lfo2 Amount", "Pan Lfo2 Amount", "LFO2 Assign Amount", "Shape Lfo2 Amount", "FM Lfo2 Amount", "LFO2 Assign Dest", "Osc Lfo3 Amount", "Assign1 Amount", "Assign1 Source", "Assign1 Destination", "Assign2 Amount1", "Assign2 Source", "Assign2 Destination1", "Assign2 Amount2", "Assign2 Destination2", "Assign3 Amount1", "Assign3 Source", "Assign3 Destination1", "Assign3 Amount2", "Assign3 Destination2", "Assign3 Amount3", "Assign3 Destination3", "Assign 4 Amount", "Assign 4 Source", "Assign 4 Destination", "Assign 5 Amount", "Assign 5 Source", "Assign 5 Destination", "Assign 6 Amount", "Assign 6 Source", "Assign 6 Destination"},
  ["EFFECTS"] = {"Distortion Curve", "Distortion Intensity", "Bass Intensity", "Bass Tune", "Phaser Mode", "Phaser Rate", "Phaser Frequency", "Phaser Depth", "Phaser Feedback", "Phaser Spread", "Phaser Mix", "Chorus Lfo Shape", "Chorus Rate", "Chorus Depth", "Chorus Feedback", "Chorus Delay", "Chorus Mix", "LowEQ Gain", "LowEQ Frequency", "MidEQ Gain", "MidEQ Frequency", "MidEQ Q-Factor", "HighEQ Gain", "HighEQ Frequency", "Effect Send"},
  ["DELAY/REV"] = {"Dly Rate / Rev Decay", "Reverb Damping", "Delay Color", "Delay Time", "Delay Feedback", "Rev Size", "Dly Depth ", "Delay Lfo Shape", "Delay/Reverb Mode", "Delay Clock"},
  ["ARP"] = {"Clock Tempo", "Arp Note Length", "Arp Swing", "Arp Mode", "Arp Pattern Selct", "Arp Octave Range", "Arp Clock", "Arp Hold Enable"},
  ["PART"] = {"Part Output Select", "Part Volume", "Part Transpose", "Part Detune", "Part Low Key", "Part High Key", "Part Midi Channel", "Part Enable"},
  ["SYSTEM"] = {"Input Follower Mode", "Vocoder Mode", "Input Select", "Input Mode", "Master Tune", "Pure Tuning", "Soft Knob-1 Mode", "Soft Knob1 ShortName", "Soft Knob-2 Mode", "Soft Knob2 ShortName", "Key Mode", "Second Output Balance", "Control Smooth Mode", "Note Steal Priority", "Master Volume", "Knob Display"},
}
  HC6_Menus["MOD EDIT"] = HC6_Menus["MOD SELECT"]
  -- OS6.6 SYSTEM subset, ROM 0x14B7E; data only, not used by menu logic.
  -- Fields: ROM index, C parameter index, mask (+1), condition (+2), confirmed Lua name.
  -- false marks an unresolved/unbound Lua parameter.
  HC6_SystemRomPages = {
    -- MULTI/PART: all six pages use key context 0x0A; only MULTI SINGLE/MULTI modes allowed.
    -- Parameters are part-specific; C32 is Part Bank Change, not C31 Part Bank Select.
    -- C32 range in Osirus: 0-29.
    {0, 72, 0xFE, 0x00, "Part Enable"},
    {1, 75, 0x3E, 0x27, "Keyb To Midi"}, -- Also requires controller flag 0x1E and C65 != 0.
    {2, 32, 0x7E, 0x1E, "Part Bank Change"}, -- RAM 0x6E == 4; ROM range 0-3.
    {3, 32, 0x7E, 0x1F, "Part Bank Change"}, -- RAM 0x6E != 4; ROM range 0-7.
    {4, 33, 0x7E, 0x00, "Part Program Change"},
    {5, 34, 0x7E, 0x00, "Part Midi Channel"},
    -- MULTI/PART 6-11: key context 0x0A; only MULTI SINGLE/MULTI, part-specific.
    -- All existing Osirus ranges match the ROM raw limits for these six pages.
    {6,  41, 0x7E, 0x00, "Part Output Select"},
    {7,  77, 0x7E, 0x00, "Note Steal Priority"}, -- C77: Multi dump bit mapping confirmed; buffer update unresolved.
    {8,  37, 0x7E, 0x00, "Part Transpose"},
    {9,  38, 0x7E, 0x00, "Part Detune"},
    {10, 39, 0x7E, 0x00, "Part Volume"},
    {11, 43, 0x7E, 0x00, false}, -- C43 PartPan: no confirmed Lua binding.
    -- MULTI/PART 12-17: key context 0x0A; only MULTI SINGLE/MULTI, part-specific.
    {12, 40, 0x7E, 0x00, "Part Midi Volume Init"},
    -- ChanVolRx: ROM specifies C40; Osirus has C73 as the matching switch.
    -- Mapping unresolved, so Lua binding remains false; ROM range 0-1.
    {13, 40, 0x7E, 0x00, false},
    {14, 35, 0x7E, 0x00, "Part Low Key"},
    {15, 36, 0x7E, 0x00, "Part High Key"},
    -- C74/C78: buffer update unresolved; effective MIDI blocking by C78 is not proven.
    {16, 74, 0x7E, 0x00, "Part Hold Pedal Enable"},
    {17, 78, 0x7E, 0x00, "Part Prog Change Enable"},
    -- RANDOM: both ROM ranges 0-127; key context 0x0A.
    -- No confirmed Osirus/Lua binding; Randomize execution unresolved.
    -- Descriptor byte +0: index 18=0x00, 19=0xD3; meaning unresolved.
    {18, 54, 0xFF, 0x00, false}, -- RANDOM Amount
    {19, 53, 0x7F, 0x00, false}, -- RANDOM ParaDepth
    -- KEYBOARD: all nine pages use key context 0x0A; controller flag 0x1E required.
    -- Full Keyboard functionality is not proven.
    {20, 64, 0xBF, 0x00, "Global Keyb Local"},
    {21, 65, 0x3F, 0x00, "Keyb Mode"},
    {22, 66, 0x3F, 0x00, "Keyb Transpose"}, -- C66 range: ROM 16-112, Osirus 0-127.
    {23, 63, 0x3F, 0x00, "Keyb Transpose Buttons"},
    {24, 67, 0x3F, 0x00, "Keyb ModWheel Contr"},
    {25, 68, 0x3F, 0x00, "Keyb Pedal 1 Contr"},
    {26, 69, 0x3F, 0x00, "Keyb Pedal 2 Contr"},
    {27, 70, 0x3F, 0x00, "Keyb Pressure Sens"},
    {28, 62, 0x3F, 0x00, false}, -- C62: no confirmed Osirus/Lua binding.
    -- Original dump execution is unresolved; no actions implemented here.
    {29, 98,  0xFF, 0x00, "Midi Dump Tx"}, -- TX: ROM 0-8, Osirus 0-4, key context 0x06.
    {30, 99,  0x7F, 0x00, "Midi Dump Rx"}, -- RX: ROM 0-5, Osirus 0-4, key context 0x0A.
    {31, 124, 0xFF, 0x00, "Midi Channel"},
    {32, 121, 0x7F, 0x00, "Panel Destination"},
    {33, 120, 0x7F, 0x00, "Soft Thru"},
    {34, 96,  0x7F, 0x00, "Midi Arpeggiator Send"},
    {35, 106, 0x7F, 0x00, "Midi Clock Rx"}, -- C106 range: ROM 0-2, Osirus 0-3; unchanged.
    {36, 87,  0x7F, 0x00, "Glob Midi Volume Enable"},
    {37, 85,  0x7F, 0x00, "Glob Prog Change Enable"},
    {38, 86,  0x7F, 0x00, "MultiProg Change Enable"},
    {39, 93,  0x7F, 0x00, "Device ID"},
    {40, 94,  0x7F, 0x00, "Midi Control Low Page"},
    {41, 95,  0x7F, 0x00, "Midi Control High Page"},
    {42, 76, 0xFF, 0x00, "Pure Tuning"}, -- ROM/Osirus range 0-127; key context 0x0A.
    {43, 92,  0xFF, 0x00, "Master Tune"},
    {44, 26,  0x7F, 0x00, false}, -- Arpeggiator: unresolved/unbound
    {45, 27,  0x7F, 0x00, false}, -- Delay: unresolved/unbound
    {46, 118, 0x7F, 0x00, "Memory Protect"},
    {47, 126, 0x7F, 0x00, "LCD Contrast"},
    {48, 117, 0x7F, 0x00, "Knob Mode"},
    {49, 97,  0x7F, 0x00, "Knob Display"},
    {50, 109, 0x7F, 0x26, false}, -- Process: unresolved/unbound
    {51, 125, 0x7F, 0x00, "Led Mode"},
    {52, 0,   0x7F, 0x26, false}, -- LedDimmer: unresolved/unbound
    -- STORE TO FLASH: key context 0x22; C55 has no confirmed Osirus/Lua binding.
    -- Action path partially reconstructed; flash execution unresolved.
    {53, 55, 0xFF, 0x1F, false}, -- RAM 0x6E != 4; ROM range 0-11.
    {54, 55, 0xFF, 0x1E, false}, -- RAM 0x6E == 4; ROM range 0-3.
  }
  -- OS6.6 LCD metadata only; fields: display type, value format, header index, label index, header, label.
  HC6_SystemRomLcd = {
    -- Type 0x06 uses a dynamic header; stored header texts are ROM references, not visible headers.
    -- Header indices 0x82/0x83 are also used for cursor control.
    [0] = {0x06, 0x4F, 0x00, 0x7E, "$$ Error at D16O", "PartEnable     $"},
    [1] = {0x06, 0x4F, 0x00, 0x52, "$$ Error at D16O", "KeybToMidi     $"},
    [2] = {0x06, 0x06, 0x82, 0x9D, "Damping        $", "SelectBank     $"},
    [3] = {0x06, 0x06, 0x82, 0x9D, "Damping        $", "SelectBank     $"},
    [4] = {0x06, 0x57, 0x83, 0x9B, "Decaytime      $", "SelctNumber    $"},
    [5] = {0x06, 0x0C, 0x00, 0x63, "$$ Error at D16O", "MidiChannel    $"},
    [6] = {0x06, 0x3B, 0x00, 0x77, "$$ Error at D16O", "OutSel         $"},
    [7] = {0x06, 0x43, 0x00, 0x88, "$$ Error at D16O", "Priority       $"},
    [8] = {0x06, 0x05, 0x00, 0x80, "$$ Error at D16O", "PartTransp     $"},
    [9] = {0x06, 0x05, 0x00, 0x7D, "$$ Error at D16O", "PartDetune     $"},
    -- Header index 0x00 adds no page-specific cursor positioning in the dynamic type 0x06 path.
    [10] = {0x06, 0x05, 0x00, 0x81, "$$ Error at D16O", "PartVolume     $"},
    [11] = {0x06, 0x04, 0x00, 0x7F, "$$ Error at D16O", "PartPan        $"}, -- No Osirus binding.
    [12] = {0x06, 0x53, 0x00, 0x14, "$$ Error at D16O", "ChanVolInit    $"},
    [13] = {0x06, 0x1E, 0x00, 0x15, "$$ Error at D16O", "ChanVolRx      $"}, -- Mapping unresolved.
    [14] = {0x06, 0x39, 0x00, 0x5F, "$$ Error at D16O", "LowKey         $"},
    [15] = {0x06, 0x39, 0x00, 0x49, "$$ Error at D16O", "HighKey        $"},
    [16] = {0x06, 0x1E, 0x00, 0x4C, "$$ Error at D16O", "HoldPedal      $"},
    [17] = {0x06, 0x1E, 0x00, 0x8A, "$$ Error at D16O", "ProgChange     $"},
    -- Type 0x01 uses the static header; both RANDOM pages have no confirmed Osirus binding.
    [18] = {0x01, 0x57, 0x53, 0x05, "$$RANDOM        ", "Amount         $"}, -- Group start.
    [19] = {0x01, 0x57, 0x53, 0x7B, "$$RANDOM        ", "ParaDepth      $"}, -- Subpage.
    -- All nine KEYBOARD pages require original controller flag 0x1E; Play Mode alone is insufficient.
    [20] = {0x01, 0x4F, 0x2E, 0x5B, "$$KEYBOARD      ", "Local          $"}, -- Group start; 21-28 are subpages.
    [21] = {0x01, 0x2B, 0x2F, 0x01, "$$KEYBOARD MODE ", "                "},
    [22] = {0x01, 0x05, 0x2E, 0xB4, "$$KEYBOARD      ", "Transpose      $"},
    [23] = {0x01, 0x09, 0x30, 0x13, "$$KEYBOARD TRANS", "Buttons        $"},
    [24] = {0x01, 0x2A, 0x31, 0x01, "$$KEYB MODWHEEL ", "                "},
    [25] = {0x01, 0x2A, 0x32, 0x01, "$$KEYB PEDAL 1  ", "                "},
    [26] = {0x01, 0x2A, 0x33, 0x01, "$$KEYB PEDAL 2  ", "                "},
    [27] = {0x01, 0x53, 0x34, 0x9F, "$$KEYB PRESSURE ", "Sensitivity    $"},
    [28] = {0x01, 0x05, 0x35, 0x1D, "$$KEYB VELOCITY ", "Curve          $"}, -- No confirmed Osirus binding.
    -- Type 0x01: static headers; neither DUMP page has an additional hardware condition.
    -- TX has a separate firmware action path; RX affects receive processing.
    -- LCD display alone does not trigger any proven SysEx action.
    [29] = {0x01, 0x08, 0x44, 0x01, "$$MIDI DUMP TX  ", "                "}, -- Group start, C98 (TX).
    [30] = {0x01, 0x07, 0x43, 0x01, "$$MIDI DUMP RX  ", "                "}, -- Subpage, C99 (RX).
    -- Type 0x01: static header; no additional hardware conditions. Index 31 starts the group; 32-39 are subpages.
    [31] = {0x01, 0x0C, 0x41, 0x45, "$$MIDI          ", "GlobalChan     $"},
    [32] = {0x01, 0x3D, 0x41, 0x78, "$$MIDI          ", "Panel          $"},
    [33] = {0x01, 0x4F, 0x41, 0xA6, "$$MIDI          ", "SoftThru       $"},
    [34] = {0x01, 0x4F, 0x41, 0x08, "$$MIDI          ", "ArpeggSend     $"},
    -- ClockRx/C106: ROM raw range 0-2, Osirus 0-3; value 3 has no assigned original OS6.6 selection.
    [35] = {0x01, 0x0D, 0x41, 0x17, "$$MIDI          ", "ClockRx        $"},
    [36] = {0x01, 0x1E, 0x41, 0x64, "$$MIDI          ", "MidiVolume     $"},
    [37] = {0x01, 0x1E, 0x41, 0x8A, "$$MIDI          ", "ProgChange     $"},
    [38] = {0x01, 0x1E, 0x41, 0x6A, "$$MIDI          ", "MultiPrgChg    $"},
    [39] = {0x01, 0x0C, 0x41, 0x26, "$$MIDI          ", "DeviceId       $"},
    -- 40/41 are subpages of the MIDI group.
    [40] = {0x01, 0x10, 0x42, 0x5E, "$$MIDI CONTROL  ", "LoPage         $"},
    [41] = {0x01, 0x0F, 0x42, 0x4A, "$$MIDI CONTROL  ", "HiPage         $"},
    -- 42 uses an empty parameter label.
    [42] = {0x01, 0x44, 0x50, 0x01, "$$PURE TUNING   ", "                "},
    [43] = {0x01, 0x05, 0x5D, 0x60, "$$SYSTEM        ", "MasterTune     $"},
    [44] = {0x01, 0x4F, 0x5D, 0x07, "$$SYSTEM        ", "Arpeggiator    $"},
    [45] = {0x01, 0x4F, 0x5D, 0x21, "$$SYSTEM        ", "Delay          $"},
    [46] = {0x01, 0x35, 0x5D, 0x61, "$$SYSTEM        ", "MemProtect     $"},
    [47] = {0x01, 0x57, 0x5D, 0x56, "$$SYSTEM        ", "LCDContrast    $"},
    [48] = {0x01, 0x2E, 0x5D, 0x54, "$$SYSTEM        ", "KnobMode       $"},
    [49] = {0x01, 0x2D, 0x5D, 0x53, "$$SYSTEM        ", "KnobDispl      $"},
    [50] = {0x01, 0x57, 0x5D, 0x89, "$$SYSTEM        ", "Process        $"},
    [51] = {0x01, 0x30, 0x5D, 0x59, "$$SYSTEM        ", "LedMode        $"},
    [52] = {0x01, 0x4F, 0x5D, 0x58, "$$SYSTEM        ", "LedDimmer    $$$"},
    -- 53/54 are alternative STORE group starts; bank indication is dynamic.
    -- No confirmed Osirus binding for C55.
    [53] = {0x01, 0x4B, 0x5B, 0xAB, "$$STORE TO FLASH", "[STORE] Bnk $$$$"},
    [54] = {0x01, 0x4C, 0x5B, 0xAB, "$$STORE TO FLASH", "[STORE] Bnk $$$$"},
  }
  function HC6_SystemGetStaticHeader(romIndex)
    if type(romIndex) ~= "number" or romIndex % 1 ~= 0
        or romIndex < 0 or romIndex > 54 then return nil end
    local entry = HC6_SystemRomLcd[romIndex]
    if type(entry) ~= "table" or entry[1] ~= 0x01 then return nil end
    local header = entry[5]
    if type(header) ~= "string" or #header ~= 16
        or string.sub(header, 1, 2) ~= "$$" then return nil end
    -- Spaces only reserve the two dynamic LCD cells.
    return "  " .. string.sub(header, 3)
  end
  function HC6_ReadName(prefix, part)
    if type(part) ~= "number" or part % 1 ~= 0
        or part < 0 or part > 15 then return nil end
    local name = ""
    for i = 0, 9 do
      local readOk, value = pcall(function() return params.get(prefix .. i, part) end)
      if not readOk or type(value) ~= "number" or value % 1 ~= 0 then return nil end
      if value == 0 then break end
      if value < 32 or value > 127 then return nil end
      name = name .. string.char(value)
    end
    return name
  end
  function HC6_ReadPartName(part)
    return HC6_ReadName("SingleName", part)
  end
  function HC6_SystemBuildPartHeader(part, single)
    if type(part) ~= "number" or part % 1 ~= 0
        or part < 0 or part > 15 then return nil end
    local ok, program = pcall(function()
      return params.get(single and "C_Undefined102" or "Part Program Change", single and 0 or part)
    end)
    if not ok or type(program) ~= "number" or program % 1 ~= 0
        or program < 0 or program > 127 then return nil end
    local name = HC6_ReadPartName(part)
    if name == nil then return nil end
    local bankChar = " "
    local bankOk, bank = pcall(function()
      return params.get(single and "C_Undefined101" or "Part Bank Select", single and 0 or part)
    end)
    if bankOk and type(bank) == "number" and bank % 1 == 0 and bank >= 0 and bank <= 7 then
      bankChar = string.char(0x41 + bank)
    end
    -- OS6.6 0C19 -> 0A55: bank in column 3, raw program in 4-6, name in 7-16.
    -- Column 1 is the existing part glyph; the unresolved status column stays blank.
    return string.format("  %s%-3d%-10s", bankChar, program, name)
  end
  function HC6_SystemResolvePage(romIndex)
    if type(romIndex) ~= "number" or romIndex % 1 ~= 0
        or romIndex < 0 or romIndex > 54 then return nil, nil end
    local page = HC6_SystemRomPages[romIndex + 1]
    if type(page) ~= "table" or page[1] ~= romIndex then return nil, nil end
    if page[5] == false then return page, nil end
    if type(page[5]) ~= "string" or page[5] == "" then return nil, nil end
    return page, page[5]
  end
  function HC6_SystemFormatMasterTune(rawValue)
    if type(rawValue) ~= "number" or rawValue % 1 ~= 0
        or rawValue < 0 or rawValue > 127 then return nil end
    return string.format("%+4d", rawValue - 64)
  end
  -- OS6.6 normal-menu formats (bit 36h clear); fields end at LCD column 15.
  function HC6_SystemFormatPartValue(format, raw)
    if type(raw) ~= "number" or raw % 1 ~= 0 or raw < 0 or raw > 127 then return nil end
    if format == 0x57 then -- 06BE: program number, without the INC at 06BD.
      return string.format("%3d", raw)
    elseif format == 0x0C then -- 06EE: MIDI channels 1..16; raw 16/Omni is out of range.
      if raw > 15 then return nil end
      return string.format("%3d", raw + 1)
    elseif format == 0x3B then -- 07F1 / B556: fifteen eight-character output names.
      local outputs = {"  Out1 L", "Out1 L+R", "  Out1 R", "  Out2 L", "Out2 L+R",
        "  Out2 R", "  Out3 L", "Out3 L+R", "  Out3 R", "  Aux1 L", "Aux1 L+R",
        "  Aux1 R", "  Aux2 L", "Aux2 L+R", "  Aux2 R"}
      return outputs[raw + 1]
    elseif format == 0x43 then -- 07BF / B64A.
      if raw > 1 then return nil end
      return raw == 0 and " Low" or "High"
    elseif format == 0x05 then -- 0682: ADD A,#C0h, signed four-character field.
      return string.format("%+4d", raw - 64)
    elseif format == 0x53 then -- 072B: zero -> 86CE (Off), otherwise 06BE.
      return raw == 0 and "Off" or string.format("%3d", raw)
    elseif format == 0x1E then -- 07CB / A3A0; deliberately not Off/On.
      if raw > 1 then return nil end
      return raw == 0 and "Dis" or "Ena"
    elseif format == 0x39 then -- 0939 / B33E: four-character note table, C-2..G8.
      if raw == 118 then return " A+7" end -- Exact ROM bytes at B518, not A#7.
      local notes = {"C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"}
      return string.format("%4s", notes[raw % 12 + 1] .. tostring(math.floor(raw / 12) - 2))
    end
    return nil
  end
  function HC6_SystemBuildPartValueLine(romIndex, part)
    if type(romIndex) ~= "number" or romIndex % 1 ~= 0
        or romIndex < 4 or romIndex > 17 then return nil end
    if type(part) ~= "number" or part % 1 ~= 0 or part < 0 or part > 15 then return nil end
    local page, parameter = HC6_SystemResolvePage(romIndex)
    if page == nil or parameter == nil then return nil end -- Unbound pages stay blank.
    local entry = HC6_SystemRomLcd[romIndex]
    if type(entry) ~= "table" or entry[1] ~= 0x06
        or type(entry[6]) ~= "string" or #entry[6] ~= 16 then return nil end
    local ok, raw = pcall(function() return params.get(parameter, part) end)
    if not ok then return nil end
    local value = HC6_SystemFormatPartValue(entry[2], raw)
    if value == nil then return nil end
    local label = string.gsub(entry[6], "%$", " ")
    -- 05D1: LCD address CFh minus table width; column 16 remains a placeholder.
    return string.sub(label, 1, 15 - #value) .. value .. " "
  end
  function HC6_SystemFormatMasterTuneLine(rawValue)
    local value = HC6_SystemFormatMasterTune(rawValue)
    if value == nil then return nil end
    return "MasterTune " .. value
  end
  function HC6_SystemBuildStaticValueLine(romIndex)
    -- Only verified C-parameter pages; C106 raw 3 has no OS6.6 menu selection.
    local limits = {[29]=4, [30]=4, [31]=15, [32]=2, [33]=1, [34]=1, [35]=2, [36]=1, [37]=1,
      [38]=1, [39]=16, [40]=1, [41]=1, [42]=127, [46]=1, [47]=127, [48]=2, [49]=3, [51]=2}
    if type(romIndex) ~= "number" or romIndex % 1 ~= 0 or limits[romIndex] == nil then return nil end
    local entry = HC6_SystemRomLcd[romIndex]
    local page, parameter = HC6_SystemResolvePage(romIndex)
    if page == nil or parameter == nil or type(entry) ~= "table" or entry[1] ~= 0x01
        or type(entry[6]) ~= "string" or #entry[6] ~= 16 then return nil end
    local part = 0
    if romIndex == 42 then -- Osirus C76 is part-sensitive, unlike the other selected globals.
      part = HC6_SystemGetCurrentPart()
      if part == nil then return nil end
    end
    local ok, raw = pcall(function() return params.get(parameter, part) end)
    if not ok or type(raw) ~= "number" or raw % 1 ~= 0
        or raw < 0 or raw > limits[romIndex] then return nil end
    -- ROM tables include field padding; 05D1 ends each field at LCD column 15.
    local enums = {
      [0x3D] = {"Internal", "Int+Midi", "    Midi"}, -- 083F / B5D0
      [0x4F] = {"Off", " On"}, -- 0783 / BE6F
      [0x0D] = {"Disable", "   Auto", "   Send"}, -- 0863 / 89A5
      [0x10] = {"SysEx", "Contr"}, -- 07B3 / 89D3
      [0x0F] = {"  SysEx", "PolyPrs"}, -- 07B9 / 89C3
      [0x2D] = {"  Off", "Short", " Long", "   On"}, -- 0845 / B0F3
      -- C98/99/117/118/125: luaParamsGet reads unnormalized integers;
      -- Controller::sendParameterChange and Microcontroller::send preserve these C bytes.
      -- No compacted enum mapping, including Boolean C118: raw 1 is Warn, not On (2).
      -- Only the exported Osirus ranges are admitted above; no dump/store action here.
      [0x08] = {"          Total", "         Global", " ControllerDump",
        "     SingleBuff", "    SingleBankA"}, -- 082D / 8791; columns 1-15
      [0x07] = {"        Disable", "         Enable", "   ForceToBankA",
        "   ForceToBankB", "ForceToEditBuff"}, -- 0833 / 8726; columns 1-15
      [0x35] = {" Off", "Warn"}, -- 0809 / B2F6; columns 12-15
      [0x2E] = {"    Off", "   Jump", "  iSnap"}, -- 0827 / B10E; columns 9-15
      [0x30] = {"    Lfo", "  ExtIn", "   Auto"} -- 0857 / B15B; columns 9-15
    }
    local format = entry[2]
    local value
    if enums[format] ~= nil then
      value = enums[format][raw + 1]
    elseif format == 0x0C then -- 06EE: 0..15 -> 1..16; Device ID also permits 16/Omni.
      value = raw == 16 and "Omni" or string.format("%3d", raw + 1)
    elseif format == 0x44 then -- 06D5: special values use B654; other values enter 06BE unchanged.
      value = ({[0]="Tempered", [64]=" Natural", [127]="    Pure"})[raw]
      if value == nil then value = HC6_SystemFormatPartValue(0x57, raw) end
    else
      value = HC6_SystemFormatPartValue(format, raw)
    end
    if value == nil then return nil end
    local label = string.gsub(entry[6], "%$", " ")
    return string.sub(label, 1, 15 - #value) .. value .. " "
  end
  function HC6_SystemGetCurrentPart()
    local ok, part = pcall(function() return params.getCurrentPart() end)
    if not ok or type(part) ~= "number" or part % 1 ~= 0
        or part < 0 or part > 15 then return nil end
    return part
  end
  -- Explicit emulated hardware context for SYSTEM-ROM filters; no keyboard autodetection.
  -- Supported: "Virus C", "Virus KC", "Indigo 2", "unknown".
  HC6_SystemControllerModel = "Virus C"
  function HC6_SystemGetControllerFlag()
    if HC6_SystemControllerModel == "Virus C" then return 0 end
    if HC6_SystemControllerModel == "Virus KC" or HC6_SystemControllerModel == "Indigo 2" then return 1 end
    return nil
  end
  -- Explicit ROM profile, not automatic ROM detection or Osirus ROM-bank count.
  -- verified_os66 SHA-256: c2b75cd0cee8f42ebafc6f491227fb4d61edfa526760ac9f9a4f4d25dffcc199
  -- Normal menu RAM 0x6E only; no DEMOSONG counter simulation. "unknown" returns nil.
  HC6_SystemFirmwareProfile = "verified_os66"
  function HC6_SystemGetBankLimit()
    if HC6_SystemFirmwareProfile == "verified_os66" then return 8 end
    return nil
  end
  -- Explicit emulated startup scenario, not detection or simulation of an Osirus boot key.
  -- OS6.6 5FD4-5FDB / 50C9: FILTERS EDIT at startup -> bit address 0Eh (IRAM 21h.6).
  -- Supported: "normal", "filters_held", "unknown"; invalid values also stay unresolved.
  HC6_SystemBootScenario = "normal"
  function HC6_SystemGetBootFlag()
    if HC6_SystemBootScenario == "normal" then return 0 end
    if HC6_SystemBootScenario == "filters_held" then return 1 end
    return nil
  end
  function HC6_SystemGetPlayMode()
    local ok, mode = pcall(function() return params.get("Play Mode", 0) end)
    if ok and (mode == 0 or mode == 1 or mode == 2) then return mode end
    return nil
  end
  function HC6_PartStep(direction)
    if HC6_StoreDialog ~= nil then return end
    if direction ~= -1 and direction ~= 1 then return end
    local mode = HC6_SystemGetPlayMode()
    if mode ~= 1 and mode ~= 2 then return end
    local part = HC6_SystemGetCurrentPart()
    if part == nil then return end
    local target = part + direction
    if target < 0 or target > 15 then return end
    local buttons = {}
    for _, element in ipairs(document:GetElementsByTagName("button")) do
      if element:GetAttribute("id") == "SelectPart" then
        buttons[#buttons + 1] = element
      end
    end
    if #buttons ~= 16 then return end
    buttons[target + 1]:Click()
    -- PART selection leaves the PATCH parameter list and shows the selected part.
    if HC6_Mode == "menu" and HC6_Group == "PATCH" then
      if HC6_Listener ~= nil then
        params.removeListener(HC6_Listener)
        HC6_Listener = nil
      end
      HC6_CurrentParam, HC6_ActiveKnob = nil, nil
      HC6_Mode = "home"
      HC6_Draw()
    end
  end
  -- View state only; instance skinvars travel with the existing SKNV project chunk.
  -- Without that backend API, views survive mode changes only while this skin is open.
  HC6_ModeViews = {}
  HC6_LfoEditPage = {}
  HC6_EffectsOrigin = nil
  HC6_DelayCopyKind = nil
  local HC6_DelayCopyMode = nil
  local HC6_DelayCopyPending = nil
  local HC6_DelayCopyDone = nil
  local HC6_ViewKey = "VirusC_HardwareC.modeViews.v1"
  local HC6_ViewData = nil
  local HC6_ViewPart = {}
  local HC6_ViewChanging = false
  local HC6_ViewPartEvents = {}
  local HC6_ViewFields = {"mode", "group", "index", "rom", "part", "knob", "param", "lastParam", "homeLabel", "bank", "edit", "effectsOrigin"}
  local HC6_ViewEdits = {{"lfo",2}, {"arp",18}, {"fx",49}, {"delay",50}, {"general",68}, {"system",69}, {"osc",89}, {"filter",128}}
  local function HC6_ReadModeViews()
    if skinvars == nil or skinvars.get == nil then return false end
    local data = skinvars.get(HC6_ViewKey, "instance")
    if data == HC6_ViewData then return false end
    HC6_ViewData, HC6_ModeViews = data, {}
    if type(data) ~= "string" then return true end
    local pos = 1
    local function field()
      local colon = string.find(data, ":", pos, true)
      local size = colon ~= nil and tonumber(string.sub(data, pos, colon - 1)) or nil
      if size == nil or size < 0 or size % 1 ~= 0 or size > 4096 or colon + size > #data then return nil end
      local value = string.sub(data, colon + 1, colon + size)
      pos = colon + size + 1
      return value
    end
    local version = field()
    if version ~= "1" and version ~= "2" then return true end
    for _, mode in ipairs({0, 2, 1}) do
      -- Legacy v1 states contain only SINGLE and MULTI; the third slot is optional.
      if mode == 1 and pos > #data then break end
      local present = field()
      if present == "1" then
        local view = {}
        for _, key in ipairs(HC6_ViewFields) do
          if key ~= "effectsOrigin" or version == "2" then
            view[key] = field()
            if view[key] == nil then HC6_ModeViews = {}; return true end
          end
        end
        local origin = tonumber(view.effectsOrigin)
        view.effectsOrigin = view.mode == "menu" and view.group == "EFFECTS"
          and (origin == 7 or origin == 8) and origin or nil
        for _, key in ipairs({"index", "rom", "part", "bank"}) do view[key] = tonumber(view[key]) end
        if (view.mode == "home" or view.mode == "menu")
            and (HC6_Menus[view.group] ~= nil or view.group == "LFO SHAPE")
            and view.index ~= nil and view.index % 1 == 0 and view.index >= 1
            and view.rom ~= nil and view.rom % 1 == 0 and view.rom >= -1 and view.rom <= 54
            and view.part ~= nil and view.part % 1 == 0 and view.part >= -1 and view.part <= 15
            and view.bank ~= nil and view.bank % 1 == 0 and view.bank >= 1 and view.bank <= #HC_R_choices then
          HC6_ModeViews[mode] = view
        end
      elseif present ~= "0" then HC6_ModeViews = {}; return true end
    end
    return true
  end
  local function HC6_ValidLfoEditPage(index)
    local list = HC6_Menus["LFO"]
    return type(index) == "number" and index % 1 == 0 and index >= 1
      and list ~= nil and index <= #list and HC6_Valid(list[index])
  end
  local function HC6_SaveModeView(mode)
    if HC6_ViewChanging or (mode ~= 0 and mode ~= 1 and mode ~= 2) then return end
    if HC6_Mode == "menu" and HC6_Group == "LFO" and HC6_ValidLfoEditPage(HC6_Index) then
      HC6_LfoEditPage[mode] = HC6_Index
    end
    if mode ~= 0 and HC6_SystemGetPlayMode() == mode then
      HC6_ViewPart[mode] = HC6_SystemGetCurrentPart()
    end
    local edit = {}
    for _, entry in ipairs(HC6_ViewEdits) do edit[#edit + 1] = HC_R_edit[entry[1]] and "1" or "0" end
    HC6_ModeViews[mode] = {
      mode = HC6_Mode, group = HC6_Group, index = HC6_Index,
      rom = HC6_SystemRomIndex or -1, part = mode ~= 0 and (HC6_ViewPart[mode] or -1) or -1,
      knob = HC6_ActiveKnob ~= nil and HC6_ActiveKnob:GetAttribute("id") or "",
      param = HC6_CurrentParam or "", lastParam = HC_R_lastParam, homeLabel = HC6_HomeLabel,
      bank = HC_R_bank, edit = table.concat(edit),
      effectsOrigin = HC6_Mode == "menu" and HC6_Group == "EFFECTS" and HC6_EffectsOrigin or nil
    }
    if skinvars == nil or skinvars.set == nil then return end
    local fields = {"2"}
    for _, savedMode in ipairs({0, 2, 1}) do
      local view = HC6_ModeViews[savedMode]
      fields[#fields + 1] = view ~= nil and "1" or "0"
      if view ~= nil then
        for _, key in ipairs(HC6_ViewFields) do fields[#fields + 1] = tostring(view[key] or "") end
      end
    end
    for i, value in ipairs(fields) do fields[i] = tostring(#value) .. ":" .. value end
    local data = table.concat(fields)
    if data ~= HC6_ViewData then
      HC6_ViewData = data
      skinvars.set(HC6_ViewKey, data, "instance")
    end
  end
  local function HC6_SelectViewPart(part)
    if HC6_SystemGetCurrentPart() == part then return true end
    local buttons = {}
    for _, element in ipairs(document:GetElementsByTagName("button")) do
      if element:GetAttribute("id") == "SelectPart" then buttons[#buttons + 1] = element end
    end
    if #buttons ~= 16 then return false end
    -- Native part callbacks are queued; do not let our own selection clear the restored view.
    HC6_ViewPartEvents[part] = (HC6_ViewPartEvents[part] or 0) + 1
    buttons[part + 1]:Click()
    if HC6_SystemGetCurrentPart() == part then return true end
    HC6_ViewPartEvents[part] = HC6_ViewPartEvents[part] - 1
    return false
  end
  local function HC6_RestoreModeView(mode)
    local view = HC6_ModeViews[mode]
    if view == nil then return false end
    HC6_ViewChanging = true
    if mode ~= 0 and view.part >= 0 then HC6_SelectViewPart(view.part) end
    if HC6_Listener ~= nil then params.removeListener(HC6_Listener) end
    HC6_Listener, HC6_CurrentParam = nil, nil
    HC6_Mode, HC6_Group, HC6_Index = view.mode, view.group, view.index
    if (mode == 0 or mode == 1 or mode == 2) and view.mode == "menu" and view.group == "LFO"
        and HC6_ValidLfoEditPage(view.index) then
      HC6_LfoEditPage[mode] = view.index
    end
    HC6_EffectsOrigin = HC6_Mode == "menu" and HC6_Group == "EFFECTS" and view.effectsOrigin or nil
    HC6_SystemRomIndex = view.rom >= 0 and view.rom or nil
    HC_R_lastParam, HC6_HomeLabel, HC_R_bank = view.lastParam, view.homeLabel, view.bank
    HC6_ActiveKnob = view.knob ~= "" and document:GetElementById(view.knob) or nil
    HC6_LastPatch = HC6_NativeText("PatchName")
    HC6_LastFocused, HC6_LastFocusValue = "", ""
    for i, entry in ipairs(HC6_ViewEdits) do
      HC_R_edit[entry[1]] = string.sub(view.edit, i, i) == "1"
      HC_R_SetLed(entry[2], HC_R_edit[entry[1]])
    end
    if HC6_Mode == "menu" then
      if HC6_Group == "LFO SHAPE" then HC6_Menus[HC6_Group] = {view.param} end
      HC6_BindSelected()
    end
    HC6_LastTop, HC6_LastBottom = nil, nil
    HC6_ViewChanging = false
    return true
  end
  -- Keep the native SelectPart path; save MULTI before SINGLE selects editor part 0.
  function HC6_SetPlayMode(mode)
    if mode ~= 0 and mode ~= 1 and mode ~= 2 then return end
    if HC6_SyncPlayMode() then HC6_Draw() end
    local previous = HC6_SystemGetPlayMode()
    if previous == mode then return end
    HC6_SaveModeView(previous)
    HC6_ViewChanging = true
    if mode == 0 and not HC6_SelectViewPart(0) then
      HC6_ViewChanging = false
      return
    end
    params.set("Play Mode", mode, 0)
    HC6_ViewChanging = false
    HC6_Draw()
  end
  function HC6_ModeButton(mode, event)
    if HC6_StoreDialog ~= nil then
      local status = params[HC6_StoreDialog.mode == 2 and "multiStoreStatus" or "singleStoreStatus"]
      if HC6_StoreDialog.token ~= nil and status ~= nil then
        pcall(status, HC6_StoreDialog.token, true)
      end
      HC6_ActiveKnob = HC6_StoreDialog.knob
      HC6_StoreDialog = nil
      HC6_Draw()
      return
    end
    if HC6_Mode == "menu" and (HC6_Group == "LFO1 SELECT" or HC6_Group == "LFO2 SELECT"
        or HC6_Group == "LFO3 SELECT" or HC6_Group == "MOD SELECT" or HC6_Group == "EFFECTS"
        or HC6_Group == "OSC" or HC6_Group == "FILTER" or HC6_Group == "LFO"
        or HC6_Group == "MOD EDIT" or HC6_Group == "ARP" or HC6_Group == "DELAY/REV") then
      if HC6_Listener ~= nil then
        params.removeListener(HC6_Listener)
        HC6_Listener = nil
      end
      HC6_CurrentParam, HC6_ActiveKnob = nil, nil
      HC6_Mode, HC6_Group = "home", "PATCH"
      HC6_Draw()
      return
    end
    if HC6_SystemGetPlayMode() == mode then
      HC6_SetPlayMode(1)
    else
      HC6_SetPlayMode(mode)
    end
  end
  function HC6_SyncPlayMode()
    if HC6_ViewChanging then return false end
    local loaded = HC6_ReadModeViews()
    local mode = HC6_SystemGetPlayMode()
    HC_R_SetLed(76, mode == 2 or mode == 1)
    HC_R_SetLed(77, mode == 0 or mode == 1)
    local changed = HC6_PlayModeKnown and mode ~= HC6_LastPlayMode
    if changed and not loaded then HC6_SaveModeView(HC6_LastPlayMode) end
    local restore = loaded or changed or not HC6_PlayModeKnown
    HC6_PlayModeKnown, HC6_LastPlayMode = true, mode
    if restore and HC6_RestoreModeView(mode) then return true end
    if changed and HC6_Mode == "menu" and (HC6_Group == "DELAY/REV"
        or (HC6_Group == "EFFECTS" and HC6_Index == 25)) then
      HC6_BindSelected()
    end
    if changed and HC6_Mode == "menu" and HC6_Group == "SYSTEM" then
      -- No view exists for this mode: retain the previous initialization fallback.
      HC6_Mode = "home"
      HC6_SystemRomIndex, HC6_CurrentParam, HC6_ActiveKnob = nil, nil, nil
      if HC6_Listener ~= nil then params.removeListener(HC6_Listener); HC6_Listener = nil end
    end
    return changed or loaded
  end
  -- Mode only: 0=SINGLE, 1=MULTI SINGLE, 2=MULTI; true is not full page visibility.
  -- Does not check keyboard flag 0x1E, RAM 0x6E, boot flag 0x0E or navigation bit 7.
  function HC6_SystemModeAllowed(page, mode)
    if mode ~= 0 and mode ~= 1 and mode ~= 2 then return nil end
    local mask = page[3]
    if mask == 0xFE or mask == 0x7E or mask == 0x3E then
      return mode ~= 0
    end
    if mask == 0xFF or mask == 0x7F or mask == 0xBF or mask == 0x3F then
      return true
    end
    return nil
  end
  -- Group-start bit 7 (0x80) only; no mode or additional-condition checks.
  function HC6_SystemIsGroupStart(page)
    local mask = page[3]
    if mask == 0xFF or mask == 0xFE or mask == 0xBF then
      return true
    end
    if mask == 0x7F or mask == 0x7E or mask == 0x3F or mask == 0x3E then
      return false
    end
    return nil
  end
  -- Additional condition only; keybMode is the supplied C65 raw value.
  function HC6_SystemConditionAllowed(page, keybMode, bankLimit, bootFlag)
    local condition = page[4]
    if condition == 0x00 then return true end
    if condition == 0x1E or condition == 0x1F then
      if bankLimit ~= 4 and bankLimit ~= 8 then return nil end
      if condition == 0x1E then return bankLimit == 4 end
      return bankLimit ~= 4
    end
    if condition == 0x27 then
      if keybMode == 0 then return false end
      if keybMode == 1 then return true end
      return nil
    end
    if condition == 0x26 then
      if bootFlag == 0 then return false end
      if bootFlag == 1 then return true end
      return nil
    end
    return nil
  end
  -- controllerFlag is supplied state, not an automatically detected hardware value.
  function HC6_SystemKeyboardAllowed(page, controllerFlag)
    if controllerFlag ~= nil and controllerFlag ~= 0 and controllerFlag ~= 1 then return nil end
    local mask = page[3]
    if mask == 0xBF or mask == 0x3F or mask == 0x3E then
      if controllerFlag == 0 then return false end
      if controllerFlag == 1 then return true end
      return nil
    end
    if mask == 0xFF or mask == 0x7F or mask == 0xFE or mask == 0x7E then
      return true
    end
    return nil
  end
  -- Combines only mode, keyboard and additional-condition checks: false before nil.
  -- Does not check navigation/group start, Lua binding or actual hardware availability.
  function HC6_SystemPageAllowed(page, mode, controllerFlag, keybMode, bankLimit, bootFlag)
    local modeAllowed = HC6_SystemModeAllowed(page, mode)
    local keyboardAllowed = HC6_SystemKeyboardAllowed(page, controllerFlag)
    local conditionAllowed = HC6_SystemConditionAllowed(page, keybMode, bankLimit, bootFlag)
    if modeAllowed == false or keyboardAllowed == false or conditionAllowed == false then
      return false
    end
    if modeAllowed == nil or keyboardAllowed == nil or conditionAllowed == nil then
      return nil
    end
    return true
  end
  -- First entry only; does not restore a saved reopening position or check Lua bindings.
  function HC6_SystemFindFirstPage(mode, controllerFlag, keybMode, bankLimit, bootFlag)
    for romIndex = 0, #HC6_SystemRomPages - 1 do
      local page = HC6_SystemRomPages[romIndex + 1]
      local allowed = HC6_SystemPageAllowed(page, mode, controllerFlag, keybMode, bankLimit, bootFlag)
      if allowed == true then return page[1] end
      if allowed == nil then return nil, "unresolved" end
    end
    return nil, "none"
  end
  -- Searches strictly beyond the current ROM index; never wraps or checks Lua bindings.
  function HC6_SystemFindParameterPage(currentRomIndex, direction, mode, controllerFlag, keybMode, bankLimit, bootFlag)
    local count = #HC6_SystemRomPages
    if type(currentRomIndex) ~= "number"
        or currentRomIndex % 1 ~= 0
        or currentRomIndex < 0
        or currentRomIndex >= count then
      return nil, "invalid"
    end
    if direction ~= 1 and direction ~= -1 then return nil, "unresolved" end
    local romIndex = currentRomIndex + direction
    while romIndex >= 0 and romIndex < #HC6_SystemRomPages do
      local page = HC6_SystemRomPages[romIndex + 1] -- Lua positions are 1-based.
      local allowed = HC6_SystemPageAllowed(page, mode, controllerFlag, keybMode, bankLimit, bootFlag)
      if allowed == true then return page[1] end
      if allowed == nil then return nil, "unresolved" end
      romIndex = romIndex + direction
    end
    return nil, "boundary"
  end
  -- At most one forward cycle; subsections never undergo the allowance check.
  function HC6_SystemFindNextGroup(currentRomIndex, mode, controllerFlag, keybMode, bankLimit, bootFlag)
    local count = #HC6_SystemRomPages
    if type(currentRomIndex) ~= "number" or currentRomIndex % 1 ~= 0
        or currentRomIndex < 0 or currentRomIndex >= count then
      return nil, "invalid"
    end
    for step = 1, count do
      local romIndex = (currentRomIndex + step) % count
      local page = HC6_SystemRomPages[romIndex + 1] -- Lua positions are 1-based.
      if HC6_SystemIsGroupStart(page) == true then
        local allowed = HC6_SystemPageAllowed(page, mode, controllerFlag, keybMode, bankLimit, bootFlag)
        if allowed == true then return page[1] end
        if allowed == nil then return nil, "unresolved" end
      end
    end
    return nil, "none"
  end
  -- OS6.6 MAIN, ROM 0x147D4. Field 4: group start; field 5: {parameter, min, max} visibility.
  HC6_MainEdit = {
    {"Clock Tempo", "CLOCK", "Tempo (bpm)", true, {"Play Mode", 0, 0}},
    {"C_Undefined15", "CLOCK", "Tempo (bpm)", true, {"Play Mode", 1, 2}},
    {"Patch Volume", "COMMON", "PatchVolume", true},
    {"Panorama", "COMMON", "Panorama"},
    {"Key Mode", "COMMON", "KeyMode"},
    {"Portamento Time", "COMMON", "Portamento"},
    {"Transpose", "COMMON", "Transpose"},
    {"Bender Range Up", "COMMON", "BendUp"},
    {"Bender Range Down", "COMMON", "BendDown"},
    {"Bender Scale", "COMMON", "BendScale"},
    {"Control Smooth Mode", "COMMON", "SmoothMode"},
    {"Unison Mode", "UNISON", "Mode", true},
    {"Unison Detune", "UNISON", "Detune", false, {"Unison Mode", 1}},
    {"Unison Pan Spread", "UNISON", "PanSpread", false, {"Unison Mode", 1}},
    {"Unison Lfo Phase", "UNISON", "LfoPhase", false, {"Unison Mode", 1}},
    {"Punch Intensity", "PUNCH", "Intensity", true},
    {"Amp Env Sustain Time", "AMP ENVELOPE", "Time", true},
    {"Osc1 Shape Velocity", "VELOCITY", "Osc1Shape", true},
    {"Osc2 Shape Velocity", "VELOCITY", "Osc2Shape"},
    {"PulseWidth Velocity", "VELOCITY", "PulseWidth"},
    {"Fm Amount Velocity", "VELOCITY", "FmAmount"},
    {"Flt1 EnvAmt Velocity", "VELOCITY", "Filt1EnvAmt"},
    {"Flt2 EnvAmt Velocity", "VELOCITY", "Filt2EnvAmt"},
    {"Resonance1 Velocity", "VELOCITY", "Resonance1"},
    {"Resonance2 Velocity", "VELOCITY", "Resonance2"},
    {"Amp Velocity", "VELOCITY", "Volume"},
    {"Panorama Velocity", "VELOCITY", "Panorama"},
    {"Second Output Balance", "SECOND OUTPUT", "Balance", true},
    {"Second Output Select", "SECOND OUTPUT", "Select"},
    {"Category1", "CATEGORY #1", "", true},
    {"Category2", "CATEGORY #2", ""},
    {"Soft Knob-1 Mode", "SOFTKNOB 1", "Mode", true},
    {"Soft Knob-1 Single", "KNOB 1 SINGLE", "", false, {"Soft Knob-1 Mode", 0, 0}},
    {"Soft Knob1 ShortName", "KNOB 1 SINGLE", "Display", false, {"Soft Knob-1 Mode", 0, 0}},
    {"Soft Knob-1 Global", "KNOB 1 GLOBAL", "", false, {"Soft Knob-1 Mode", 0, 1}},
    {"Soft Knob-2 Mode", "SOFTKNOB 2", "Mode", true},
    {"Soft Knob-2 Single", "KNOB 2 SINGLE", "", false, {"Soft Knob-2 Mode", 0, 0}},
    {"Soft Knob2 ShortName", "KNOB 2 SINGLE", "Display", false, {"Soft Knob-2 Mode", 0, 0}},
    {"Soft Knob-2 Global", "KNOB 2 GLOBAL", "", false, {"Soft Knob-2 Mode", 0, 1}}
  }
  HC6_Menus["MAIN"] = {}
  for i,row in ipairs(HC6_MainEdit) do HC6_Menus["MAIN"][i] = row[1] end
  HC6_Mode = "home"
  HC6_Group = "PATCH"
  HC6_Index = 1
  HC6_SystemRomIndex = nil
  HC6_CurrentParam = nil
  HC6_Listener = nil
  HC6_NextTick = 0
  HC6_HomeLabel = "Cutoff"
  HC6_LastPatch = ""
  HC6_LastFocused = ""
  HC6_LastFocusValue = ""
  HC6_LastTop = nil
  HC6_LastBottom = nil
  HC6_ActiveKnob = nil

  function HC6_KnobInput(event)
    if HC6_StoreDialog ~= nil then return end
    if HC6_Mode ~= "home" or knobs == nil or knobs.getUserPosition == nil then return end
    if params.get("Knob Display") == 0 then return end
    local element = event.target_element
    while element ~= nil do
      if element:IsClassSet("hardwareVirusKnob") then
        HC6_ActiveKnob = element
        return
      end
      element = element.parent_node
    end
  end

  function HC6_Clean(s)
    s = tostring(s or "")
    s = string.gsub(s, "<[^>]*>", "")
    s = string.gsub(s, "&amp;", "&")
    s = string.gsub(s, "&lt;", "<")
    s = string.gsub(s, "&gt;", ">")
    return string.gsub(s, "[%c]", " ")
  end
  function HC6_Encode(s)
    s = HC6_Clean(s)
    s = string.gsub(s, "&", "&amp;")
    s = string.gsub(s, "<", "&lt;")
    return string.gsub(s, ">", "&gt;")
  end
  function HC6_Text(id, value)
    local node = document:GetElementById(id)
    if node ~= nil then node.inner_rml = HC6_Encode(value) end
  end
  function HC6_NativeText(id)
    local el = document:GetElementById(id)
    if (id == "FocusedParameterName" or id == "FocusedParameterValue")
        and el ~= nil and el.style.display == "none" then return "" end
    return el ~= nil and HC6_Clean(el.inner_rml) or ""
  end
  function HC6_ParameterName()
    local list = HC6_Menus[HC6_Group]
    return list ~= nil and list[HC6_Index] or nil
  end
  function HC6_Valid(p)
    if p == nil then return false end
    return params.getInfo(p) ~= nil
  end
  function HC6_PageValid(index, groupsOnly)
    local list = HC6_Menus[HC6_Group]
    if HC6_Group=="LFO3 SELECT" and index==7 then return true end
    if list == nil or not HC6_Valid(list[index]) then return false end
    if HC6_Group ~= "MAIN" then return true end
    local page = HC6_MainEdit[index]
    if groupsOnly and not page[4] then return false end
    local condition = page[5]
    if condition == nil then return true end
    local value = params.get(condition[1])
    return value >= condition[2] and (condition[3] == nil or value <= condition[3])
  end
  function HC6_ModSelectGroup(index)
    if type(index) ~= "number" or index % 1 ~= 0 or index < 1 or index > 24 then return nil end
    for group, lastPage in ipairs({3, 8, 15, 18, 21, 24}) do
      if index <= lastPage then return group end
    end
  end
  function HC6_BindSelected()
    if HC6_Listener ~= nil then
      params.removeListener(HC6_Listener)
      HC6_Listener = nil
    end
    if HC6_Group=="LFO3 SELECT" and HC6_Index==7 then
      HC6_CurrentParam=nil
      return
    end
    if HC6_Group == "DELAY/REV" then
      local mode = HC6_SystemGetPlayMode()
      local multiParams = {"C_Undefined19", "C_Undefined21", "C_Undefined24",
        "C_Undefined17", "C_Undefined18", "C_Undefined20", "C_Undefined20",
        "C_Undefined21", "C_Undefined16", "C_Undefined23"}
      local name = mode == 0 and HC6_ParameterName()
        or (mode == 1 or mode == 2) and multiParams[HC6_Index] or nil
      local ok, valid = pcall(function() return HC6_Valid(name) end)
      HC6_CurrentParam = ok and valid and name or nil
    elseif HC6_Group == "EFFECTS" and HC6_Index == 25 then
      local mode = HC6_SystemGetPlayMode()
      local name = mode == 0 and "Effect Send"
        or (mode == 1 or mode == 2) and "C_Undefined42" or nil
      local ok, valid = pcall(function() return HC6_Valid(name) end)
      HC6_CurrentParam = ok and valid and name or nil
    elseif HC6_Group == "SYSTEM" and HC6_SystemRomIndex ~= nil then
      local page, name = HC6_SystemResolvePage(HC6_SystemRomIndex)
      HC6_CurrentParam = nil
      if page == nil or page[5] == false or not HC6_Valid(name) then return end
      HC6_CurrentParam = name
    else
      local name = HC6_ParameterName()
      if not HC6_PageValid(HC6_Index) then
        local list = HC6_Menus[HC6_Group]
        if list ~= nil then
          for i = 1, #list do
            if HC6_PageValid(i) then
              HC6_Index = i
              name = list[i]
              break
            end
          end
        end
      end
      HC6_CurrentParam = HC6_PageValid(HC6_Index) and name or nil
    end
    if (HC6_Group=="MOD SELECT" or HC6_Group=="MOD EDIT") and HC6_CurrentParam ~= nil then
      local group = HC6_ModSelectGroup(HC6_Index)
      if group ~= nil then HC_R_assignSlot = group end
    end
    if HC6_CurrentParam ~= nil then
      HC_R_lastParam = HC6_CurrentParam
      HC6_Listener = params.onChange(HC6_CurrentParam, function()
        if HC6_Mode == "menu" then HC6_Draw() end
      end)
    end
  end
  function HC6_SystemBottomGlyph()
    -- C117 is passed through unchanged: OS6.6 0=Off, 1=Jump, 2=iSnap.
    -- 3343 -> 397A blanks Off; 3674-3693 uses 03 for 1/2, not SNAP/RELATIVE.
    local ok, mode = pcall(function() return params.get("Knob Mode", 0) end)
    if ok and (mode == 1 or mode == 2) then return 0x03 end
    return nil
  end
  local function HC6_CopyRawValid(value, info)
    return type(value) == "number" and value % 1 == 0 and value >= 0 and value <= 127
      and type(info) == "table" and type(info.min) == "number" and type(info.max) == "number"
      and value >= info.min and value <= info.max
  end
  function HC6_DelayCopyStore()
    if HC6_DelayCopyPending ~= nil or HC6_Mode ~= "menu" or HC6_Group ~= "DELAY/REV"
        or HC6_Index ~= 9 or (HC6_DelayCopyKind ~= "Delay" and HC6_DelayCopyKind ~= "Revrb")
        or HC6_SystemGetPlayMode() ~= 0 then return end
    local ok = pcall(function()
      local part = HC6_SystemGetCurrentPart()
      if type(part) ~= "number" or part % 1 ~= 0 or part < 0 or part > 15 then return end
      local mode = params.get("Delay/Reverb Mode", part)
      if type(mode) ~= "number" or mode % 1 ~= 0 or mode < 1 or mode > 26
          or mode ~= HC6_DelayCopyMode then return end
      local reverb = mode >= 2 and mode <= 4
      if HC6_DelayCopyKind ~= (reverb and "Revrb" or "Delay") then return end
      local sources = {"Delay/Reverb Mode", "Effect Send", "Delay Time", "Delay Feedback",
        "Dly Rate / Rev Decay", reverb and "Rev Size" or "Dly Depth ",
        reverb and "Reverb Damping" or "Delay Lfo Shape", "Delay Color", "Delay Clock"}
      local targets = {"C_Undefined16", "C_Undefined42", "C_Undefined17", "C_Undefined18",
        "C_Undefined19", "C_Undefined20", "C_Undefined21", "C_Undefined24", "C_Undefined23"}
      local values = {}
      for i, name in ipairs(sources) do
        local value = params.get(name, part)
        if not HC6_CopyRawValid(value, params.getInfo(name)) then return end
        values[i] = value
      end
      for i, name in ipairs(targets) do
        if not HC6_CopyRawValid(values[i], params.getInfo(name)) then return end
      end
      if HC6_SystemGetPlayMode() ~= 0 or HC6_SystemGetCurrentPart() ~= part then return end
      HC6_DelayCopyDone = nil
      HC6_DelayCopyPending = {targets=targets, values=values, phase="mode", ticks=0}
      HC6_SetPlayMode(1)
    end)
    if not ok then HC6_DelayCopyPending = nil end
  end
  function HC6_Store()
    -- Keep the validated G9/A14 COPY dispatch, including its own guards.
    if HC6_DelayCopyPending ~= nil or HC6_DelayCopyKind ~= nil then
      HC6_DelayCopyStore()
      return
    end
    if HC6_StoreDialog ~= nil then
      local dialog = HC6_StoreDialog
      -- SINGLE uses three arguments; MULTI SINGLE supplies its source part.
      if dialog.token ~= nil then HC6_Draw(); return end
      if HC6_SystemGetPlayMode() ~= dialog.mode or HC6_SystemGetCurrentPart() ~= dialog.part then
        HC6_Draw(); return -- Existing mode/part-change cancellation, not a write.
      end
      local store = params[dialog.mode == 2 and "storeMulti" or "storeSingle"]
      local status = params[dialog.mode == 2 and "multiStoreStatus" or "singleStoreStatus"]
      if store == nil or status == nil then
        dialog.storeStatus = "BRIDGE MISSING"
        HC6_Draw(); return
      end
      local ok, protect = pcall(function() return params.get("Memory Protect", 0) end)
      if not ok or protect ~= 0 then
        dialog.storeStatus = ok and protect ~= 0 and "protected" or "C118 READ ERROR"
        HC6_Draw()
        return
      end
      local chars = {}
      for i = 1, 10 do chars[i] = string.char(dialog.name[i]) end
      local sent, token, reason
      if dialog.mode == 2 then
        sent, token, reason = pcall(store, dialog.program, table.concat(chars))
      elseif dialog.mode == 1 then
        sent, token, reason = pcall(store, dialog.bank, dialog.program, table.concat(chars), dialog.part)
      else
        sent, token, reason = pcall(store, dialog.bank, dialog.program, table.concat(chars))
      end
      if sent and type(token) == "number" and token > 0 then
        dialog.token, dialog.storeStatus = token, "pending"
      else
        dialog.storeStatus = sent and (reason or "STORE REJECTED") or "LUA BRIDGE ERROR"
      end
      HC6_Draw()
      return
    end
    if HC6_SyncPlayMode() then HC6_Draw(); return end
    local mode = HC6_SystemGetPlayMode()
    if mode ~= 0 and mode ~= 1 and mode ~= 2 then return end
    -- G15 S2: FB/K33 (SINGLE/MULTI SINGLE); S13: FC/K32 (MULTI).
    local part = HC6_SystemGetCurrentPart()
    if part == nil then return end
    local ok, bank, program = pcall(function()
      if mode == 2 then return 0, params.get("Multi Program Change", 0) end
      return params.get(mode == 0 and "C_Undefined101" or "Part Bank Select", mode == 0 and 0 or part),
        params.get(mode == 0 and "C_Undefined102" or "Part Program Change", mode == 0 and 0 or part)
    end)
    if not ok or type(bank) ~= "number" or bank % 1 ~= 0 or bank < 0 or bank > 7
        or type(program) ~= "number" or program % 1 ~= 0 or program < 0 or program > 127 then return end
    local limit = HC6_SystemGetBankLimit()
    if mode ~= 2 and limit ~= 4 and limit ~= 8 then return end
    local name = {}
    for i = 0, 9 do
      local readOk, value = pcall(function()
        return params.get((mode == 2 and "MultiName" or "SingleName") .. i, mode == 2 and 0 or part)
      end)
      if not readOk or type(value) ~= "number" or value % 1 ~= 0
          or (value ~= 0 and (value < 0x20 or value > 0x7F)) then return end
      name[i + 1] = value == 0 and 0x20 or value
    end
    -- ROM-bank sources cannot be STORE destinations; start those drafts at RAM A.
    HC6_StoreDialog = {mode=mode, part=part, context=mode == 2 and 32 or 33,
      bank=bank <= 1 and bank or 0, program=program, name=name,
      page=mode == 2 and 13 or 2, bankPage=limit == 4 and 0 or 1,
      cursor=4, knob=HC6_ActiveKnob}
    HC6_Draw()
  end
  local function HC6_StorePage(dialog)
    -- G15 +13 is the DDRAM cursor address; +14 selects ROM label AC/AD.
    local firstName = dialog.context == 32 and 14 or 3
    if dialog.page >= firstName then
      return dialog.page - firstName + 7, "[STORE] NEW NAME"
    end
    return dialog.page == dialog.bankPage and 3 or 4, "[STORE] TO...   "
  end
  local function HC6_StoreStep(delta, value)
    local dialog = HC6_StoreDialog
    if dialog == nil or (delta ~= -1 and delta ~= 1) then return end
    -- Freeze the submitted draft; never change a request while readback is outstanding.
    if dialog.token ~= nil then return end
    dialog.storeStatus = nil
    if HC6_SystemGetPlayMode() ~= dialog.mode or HC6_SystemGetCurrentPart() ~= dialog.part then
      HC6_StoreDialog = nil
      HC6_Draw()
      return
    end
    local firstName = dialog.context == 32 and 14 or 3
    if value then
      if dialog.page >= firstName then
        local index = dialog.page - firstName + 1
        -- All twenty G15 NAME descriptors specify 20h..7Fh, step 1.
        dialog.name[index] = math.max(0x20, math.min(0x7F, dialog.name[index] + delta))
      elseif dialog.context == 33 and dialog.page == dialog.bankPage then
        dialog.bank = math.max(0, math.min(1, dialog.bank + delta))
      else
        dialog.program = math.max(0, math.min(127, dialog.program + delta))
      end
    else
      local first = dialog.context == 32 and 13 or dialog.bankPage
      local last = dialog.context == 32 and 23 or 12
      local target = dialog.page + delta
      if dialog.context == 33 and target < 2 then
        target = delta < 0 and dialog.bankPage or 2
      end
      dialog.page = math.max(first, math.min(last, target))
    end
    dialog.cursor = HC6_StorePage(dialog)
    HC6_Draw()
  end
  local function HC6_DelayCopyStep()
    if HC6_DelayCopyDone ~= nil then
      HC6_DelayCopyDone.ticks = HC6_DelayCopyDone.ticks - 1
      if HC6_DelayCopyDone.ticks <= 0 then HC6_DelayCopyDone = nil; HC6_Draw() end
    end
    local copy = HC6_DelayCopyPending
    if copy == nil then return end
    local ok = pcall(function()
      copy.ticks = copy.ticks + 1
      if copy.ticks > 50 then HC6_DelayCopyPending = nil; return end
      local mode = HC6_SystemGetPlayMode()
      if copy.phase == "mode" then
        if mode == 0 then return end
        if mode ~= 1 then HC6_DelayCopyPending = nil; return end
        local part = HC6_SystemGetCurrentPart()
        if type(part) ~= "number" or part % 1 ~= 0 or part < 0 or part > 15 then
          HC6_DelayCopyPending = nil; return
        end
        -- Validate every destination before the first write; never default to part 0.
        for i, name in ipairs(copy.targets) do
          local info = params.getInfo(name)
          if not HC6_CopyRawValid(copy.values[i], info)
              or not HC6_CopyRawValid(params.get(name, part), info) then
            HC6_DelayCopyPending = nil; return
          end
        end
        copy.part, copy.phase = part, "readback"
        for i, name in ipairs(copy.targets) do
          if HC6_SystemGetPlayMode() ~= 1 or HC6_SystemGetCurrentPart() ~= part then
            HC6_DelayCopyPending = nil; return
          end
          params.set(name, copy.values[i], part)
        end
        return -- Read back on a later existing tick, not in the setter call stack.
      end
      if mode ~= 1 or HC6_SystemGetCurrentPart() ~= copy.part then
        HC6_DelayCopyPending = nil; return
      end
      for i, name in ipairs(copy.targets) do
        if params.get(name, copy.part) ~= copy.values[i] then copy.matches = 0; return end
      end
      copy.matches = (copy.matches or 0) + 1
      if copy.matches < 2 then return end
      HC6_DelayCopyPending = nil
      HC6_DelayCopyDone = {ticks=10, mode=HC6_Mode, group=HC6_Group, index=HC6_Index, part=copy.part}
      HC6_Draw()
    end)
    if not ok then HC6_DelayCopyPending = nil end
  end
  function HC6_Draw()
    if HC6_ViewChanging then return end
    HC6_SyncPlayMode()
    if HC6_Mode ~= "menu" or HC6_Group ~= "EFFECTS" then HC6_EffectsOrigin = nil end
    if HC6_DelayCopyKind ~= nil then
      local ok, mode = pcall(function() return params.get("Delay/Reverb Mode") end)
      if HC6_Mode ~= "menu" or HC6_Group ~= "DELAY/REV" or HC6_Index ~= 9
          or not ok or type(mode) ~= "number" or mode % 1 ~= 0 or mode < 0 or mode > 26
          or mode ~= HC6_DelayCopyMode then
        HC6_DelayCopyKind, HC6_DelayCopyMode = nil, nil
      end
    end
    for _,row in ipairs(HC_R_amounts) do
      if row[1]>=20 and row[1]<=24 then HC_R_ShowAmount(row[1],params.get(row[2])) end
    end
    HC_R_ShowAssignAmount(25,params.get("LFO1 Assign Dest"),params.get("LFO1 Assign Amount"))
    for _,row in ipairs(HC_R_amounts) do
      if row[1]>=26 and row[1]<=30 then HC_R_ShowAmount(row[1],params.get(row[2])) end
    end
    HC_R_ShowAssignAmount(31,params.get("LFO2 Assign Dest"),params.get("LFO2 Assign Amount"))
    HC_R_ShowLfo3(params.get("Lfo3 Destination"))
    HC_R_ShowAssign()
    if HC6_Mode == "menu" and HC6_Group == "MAIN" and not HC6_PageValid(HC6_Index) then
      HC6_BindSelected()
    end
    HC_R_edit.general = HC6_Mode == "menu" and HC6_Group == "MAIN"
    HC_R_SetLed(68, HC_R_edit.general)
    HC_R_edit.system = HC6_Mode == "menu" and HC6_Group == "SYSTEM"
    HC_R_SetLed(69, HC_R_edit.system)
    for _, row in ipairs({
      {"lfo", "LFO", 2}, {"arp", "ARP", 18}, {"fx", "EFFECTS", 49},
      {"delay", "DELAY/REV", 50}, {"osc", "OSC", 89}, {"filter", "FILTER", 128}
    }) do
      HC_R_edit[row[1]] = HC6_Mode == "menu" and (HC6_Group == row[2]
        or (row[1] == "lfo" and HC6_Group == "MOD EDIT"))
      HC_R_SetLed(row[3], HC_R_edit[row[1]])
    end
    local top = ""
    local lower = ""
    if HC6_Mode == "menu" and HC6_Group == "SYSTEM" and HC6_SystemRomIndex ~= nil then
      local header = HC6_SystemGetStaticHeader(HC6_SystemRomIndex)
      top = header or "                "
      lower = "                "
      local entry = HC6_SystemRomLcd[HC6_SystemRomIndex]
      if type(entry) == "table" and type(entry[6]) == "string" and #entry[6] == 16 then
        lower = string.gsub(entry[6], "%$", " ")
      end
      local valueLine = HC6_SystemBuildStaticValueLine(HC6_SystemRomIndex)
      if valueLine ~= nil then lower = valueLine end
    elseif HC6_Mode == "menu" then
      local list = HC6_Menus[HC6_Group] or {}
      top = string.format("%s %d/%d", HC6_Group, HC6_Index, #list)
      local p = HC6_CurrentParam
      if p ~= nil then
        local info = params.getInfo(p)
        local label = info ~= nil and info.displayName or p
        if HC6_Group == "EFFECTS" and HC6_Index == 25 and p == "C_Undefined42" then
          label = "Effect Send"
        end
        local val = params.getText(p)
        if val == nil or val == "" then val = tostring(params.get(p) or "--") end
        if HC6_Group == "FILTER" and (p == "Filter1 Mode" or p == "Filter2 Mode") then
          local raw = params.get(p)
          local compact = ({[0]="LP", "HP", "BP", "BS"})[raw]
          if p == "Filter1 Mode" then
            compact = compact or ({[4]="A1P", [5]="A2P", [6]="A3P", [7]="A4P"})[raw]
          end
          val = compact or val
        end
        if HC6_Group == "LFO SHAPE" then label = string.match(p, "^Lfo[123]") or p end
        if HC6_Group == "LFO1 SELECT" then
          label=({"OSC1", "OSC1+OSC2", "OSC2", "PW", "RESO", "FLT GAIN", "ASSIGN Target", "ASSIGN Amount"})[HC6_Index]
        end
        if HC6_Group == "LFO2 SELECT" then
          label=({"FILTER1", "FILTER1+FILTER2", "FILTER2", "SHAPE", "FM AMT", "PAN", "ASSIGN Target", "ASSIGN Amount"})[HC6_Index]
        elseif HC6_Group == "LFO3 SELECT" then
          label=({"OSC1", "OSC1+OSC2", "OSC2", "PW1", "PW1+PW2", "PW2"})[HC6_Index]
        elseif HC6_Group == "MOD SELECT" or HC6_Group == "MOD EDIT" then
          local group = HC6_ModSelectGroup(HC6_Index)
          if group ~= nil then
            local field = string.match(p, "(%S+)$")
            field = string.gsub(field, "Source", "SRC")
            field = string.gsub(field, "Destination", "DST")
            field = string.gsub(field, "Amount", "AMT")
            label = "ASSIGN" .. group .. " " .. field
          end
        end
        if p == "Knob Display" then
          label = "KnobDispl"
          val = ({[0]="OFF", "SHORT", "LONG", "ON"})[params.get(p)] or val
        end
        -- Fit the label around the complete value on the 18-column display.
        label = HC6_Clean(label)
        val = HC6_Clean(val)
        if #val > 17 then
          local raw = params.get(p)
          if type(raw) == "number" then val = tostring(raw) end
        end
        local limit = math.max(0, 18 - #val - 1)
        lower = (limit > 0 and string.sub(label, 1, limit) .. " " or "") .. val
        if HC6_Group == "DELAY/REV" then
          local names = {"Rate/Decay", "Rev Damping", "Delay Color", "Delay Time",
            "Delay Feedback", "Rev Size", "Dly Depth", "LFO Shape", "Mode", "Delay Clock"}
          local raw = tostring(params.get(HC6_CurrentParam) or "--")
          local name = names[HC6_Index] or ""
          lower = string.sub(name, 1, math.max(0, 18 - #raw - 1)) .. " " .. raw
        elseif HC6_Group == "MAIN" then
          local page = HC6_MainEdit[HC6_Index]
          top = page[2]
          local width = math.max(0, 17 - #val)
          lower = val
          if width > 0 then
            lower = string.format("%-" .. width .. "s %s", string.sub(page[3], 1, width), val)
          end
        end
      else
        lower = "No mapped parameter"
        if HC6_Group=="LFO3 SELECT" and HC6_Index==7 then lower="SYNC PHASE" end
      end
    else
      local part = tonumber(params.getCurrentPart()) or 0
      -- Read the selected sound, not the GUI PatchName toggle or its delayed cache.
      local patch = HC6_ReadPartName(part) or ""
      top = string.format("P%02d %s", part + 1, patch)
      local label = HC6_LastFocused
      local value = HC6_LastFocusValue
      if label == "" then
        label = HC6_Clean(params.getText("Soft Knob1 ShortName"))
        value = HC6_Clean(params.getText("Soft Knob2 ShortName"))
      end
      if HC6_LastFocused ~= "" then
        label = string.gsub(label, "^Osc%s*([123])%s+Semitones?$", "Osc%1 Semi")
      end
      lower = HC6_Clean(label) .. " " .. HC6_Clean(value)
      if HC6_LastFocused == "" then
        lower = string.format("%-9.9s%9.9s", label, value)
      end
      if HC6_LastFocused ~= "" then
        local text = HC6_Clean(value)
        local shortLabel = string.sub(HC6_Clean(label), 1, math.max(0, 18 - #text - 1))
        lower = (shortLabel ~= "" and shortLabel .. " " or "") .. text
        local waveOsc = string.match(HC6_LastFocused, "^Osc%s*([12])%s+Wave%s+Select$")
        if waveOsc ~= nil then
          lower = string.format("Osc%s%14s", waveOsc, text)
        end
        local detuneOsc = string.match(HC6_LastFocused, "^Osc%s*([23])%s+Detune$")
        local detune = detuneOsc ~= nil and tonumber(params.get("Osc" .. detuneOsc .. " Detune")) or nil
        if detune ~= nil then
          lower = string.format("Detune%s%+11d", detuneOsc, detune)
        end
      end
    end
    if HC6_Mode == "home" and HC6_ActiveKnob ~= nil then
      local p = HC6_ActiveKnob:GetAttribute("param")
      local position = knobs.getUserPosition(HC6_ActiveKnob)
      local right = "nil"
      if position ~= nil then
        right = string.format("%.3f", position):gsub("0+$", ""):gsub("%.$", "")
      end
      top = p
      lower = string.format("%-9s%9s", tostring(params.get(p)), right)
    end
    local partGlyph = nil
    local bottomGlyph = nil
    if HC6_Mode == "home" and HC6_ActiveKnob == nil and HC6_LastFocused == "" then
      local mode = HC6_SystemGetPlayMode()
      local part = HC6_SystemGetCurrentPart()
      if part ~= nil and (mode == 0 or mode == 1 or mode == 2) then
        local header = HC6_SystemBuildPartHeader(part, mode == 0)
        if header ~= nil then
          if mode == 0 or mode == 1 then
            -- ROM 150A9/150C1: type 06 -> 0C19, SINGLE or selected MULTI SINGLE.
            top, partGlyph = header, part
          else
            -- ROM 150D9: type 05 -> 0C92, MULTI above its selected SINGLE.
            local ok, program = pcall(function() return params.get("Multi Program Change", 0) end)
            local name = HC6_ReadName("MultiName", 0)
            if ok and type(program) == "number" and program % 1 == 0
                and program >= 0 and program <= 127 and name ~= nil then
              top = string.format("  %s%-3d%-10s", string.char(0x4D), program, name)
              lower = string.sub(header, 3) .. "  "
              partGlyph = part
            end
          end
        end
      end
    end
    if HC6_Mode == "menu" and HC6_Group == "SYSTEM" and HC6_SystemRomIndex ~= nil then
      local entry = HC6_SystemRomLcd[HC6_SystemRomIndex]
      if type(entry) == "table" and entry[1] == 0x06 then
        local mode = HC6_SystemGetPlayMode()
        if mode == 1 or mode == 2 then
          local part = HC6_SystemGetCurrentPart()
          if part ~= nil then
            local header = HC6_SystemBuildPartHeader(part)
            if type(header) == "string" and #header == 16 then
              top, partGlyph = header, part
            end
            if HC6_SystemRomIndex == 0 then
              lower = "PartEnable      "
              local ok, value = pcall(function() return params.get("Part Enable", part) end)
              if ok and (value == 0 or value == 1) then
                lower = "PartEnable  " .. (value == 0 and "Off" or " On") .. " "
                bottomGlyph = HC6_SystemBottomGlyph()
              end
            elseif HC6_SystemRomIndex == 3 then
              local ok, value = pcall(function() return params.get("Part Bank Change", part) end)
              if ok and type(value) == "number" and value % 1 == 0 and value >= 0 and value <= 7 then
                lower = string.sub(lower, 1, 14) .. string.char(0x41 + value) .. " "
              end
            elseif HC6_SystemRomIndex >= 4 and HC6_SystemRomIndex <= 17 then
              local line = HC6_SystemBuildPartValueLine(HC6_SystemRomIndex, part)
              if line ~= nil then lower = line end
            end
          end
        end
      elseif type(entry) == "table" and entry[1] == 0x01 then
        local mode = HC6_SystemGetPlayMode()
        if mode == 1 or mode == 2 then
          partGlyph = HC6_SystemGetCurrentPart()
        end
      end
    end
    if HC6_Mode == "menu" and HC6_Group == "SYSTEM" and HC6_CurrentParam == "Master Tune" then
      local mode = HC6_SystemGetPlayMode()
      if mode == 1 or mode == 2 then
        top = "  SYSTEM        " -- Column 2 is a temporary status placeholder.
        partGlyph = HC6_SystemGetCurrentPart()
        local tuneLine = HC6_SystemFormatMasterTuneLine(params.get("Master Tune"))
        if tuneLine ~= nil then
          lower = tuneLine .. " "
          if HC6_SystemRomIndex == 43 then bottomGlyph = HC6_SystemBottomGlyph() end
        end
      end
    end
    if HC6_DelayCopyKind ~= nil then
      top = "Copy Single" .. HC6_DelayCopyKind
      lower = " ~ Multi [STORE]"
      partGlyph, bottomGlyph = nil, nil
    end
    if HC6_DelayCopyDone ~= nil then
      local done = HC6_DelayCopyDone
      if HC6_SystemGetPlayMode() == 1 and HC6_SystemGetCurrentPart() == done.part
          and HC6_Mode == done.mode and HC6_Group == done.group and HC6_Index == done.index then
        lower = "         ...done"
        bottomGlyph = nil
      else
        HC6_DelayCopyDone = nil
      end
    end
    if HC6_StoreDialog ~= nil then
      local dialog = HC6_StoreDialog
      if HC6_SystemGetPlayMode() ~= dialog.mode or HC6_SystemGetCurrentPart() ~= dialog.part then
        local status = params[dialog.mode == 2 and "multiStoreStatus" or "singleStoreStatus"]
        if dialog.token ~= nil and status ~= nil then
          pcall(status, dialog.token, true)
        end
        HC6_StoreDialog = nil
      else
        local status = params[dialog.mode == 2 and "multiStoreStatus" or "singleStoreStatus"]
        if dialog.token ~= nil and status ~= nil then
          local ok, result = pcall(status, dialog.token)
          dialog.storeStatus = ok and result or "STATUS READ ERROR"
        end
        local chars = {}
        for i = 1, 10 do chars[i] = string.char(dialog.name[i]) end
        -- ROM 0CEC/0D09: bank or M at column 3, program at 4-6.
        -- The local draft is displayed without loading the destination preset.
        top = string.format("  %s%-3d%s", dialog.context == 32 and "M"
          or string.char(0x41 + dialog.bank), dialog.program, table.concat(chars))
        dialog.cursor, lower = HC6_StorePage(dialog)
        partGlyph, bottomGlyph = dialog.part, nil
        if dialog.storeStatus == "stored" then
          -- OS6.6 text 0Ah/0Bh; only after validated target readback.
          top, lower, partGlyph = dialog.mode == 2 and "Multi-Program" or "Single-Program", "...stored!", nil
        elseif dialog.storeStatus == "protected" then
          -- Conservative block for JSON 1 as well as ROM 2; no enum translation.
          top, lower, partGlyph = "-- MEMORY --", "--- PROTECT---", nil
        elseif dialog.storeStatus ~= nil then
          -- Explicit diagnostics, not invented ROM menu pages. Never imply an unwritten target on a readback failure.
          top, lower, partGlyph = dialog.storeStatus == "pending" and "STORE" or "STORE ERROR",
            dialog.storeStatus == "pending" and "Checking..." or dialog.storeStatus, nil
        end
      end
    end
    local cursor = HC6_StoreDialog ~= nil and HC6_StoreDialog.storeStatus == nil and HC6_StoreDialog.cursor or nil
    if top ~= HC6_LastTop or partGlyph ~= HC6_LastTopPart or cursor ~= HC6_LastTopCursor then
      HC6_Text("HC6_LcdTop", top, partGlyph, nil, cursor)
      HC6_LastTop, HC6_LastTopPart = top, partGlyph
      HC6_LastTopCursor = cursor
    end
    if lower ~= HC6_LastBottom or bottomGlyph ~= HC6_LastBottomGlyph then
      HC6_Text("HC6_LcdBottom", lower, nil, bottomGlyph)
      HC6_LastBottom, HC6_LastBottomGlyph = lower, bottomGlyph
    end
    HC6_SaveModeView(HC6_SystemGetPlayMode())
  end
  function HC6_EffectsEditTarget()
    if HC6_Mode ~= "menu" or HC6_Group ~= "EFFECTS" then return nil end
    local index = HC6_Index
    if type(index) ~= "number" or index % 1 ~= 0 or index < 1 or index > 25 then return nil end
    local mixName
    if HC6_EffectsOrigin == 7 then mixName = "Phaser Mix"
    elseif HC6_EffectsOrigin == 8 then mixName = "Chorus Mix"
    else return nil end
    local mix = params.get(mixName)
    if type(mix) ~= "number" or mix ~= mix then return nil end
    local common = index == 3 or index == 4 or (index >= 18 and index <= 24)
    if HC6_EffectsOrigin == 7 then
      if index == 11 then return mix == 0 and 3 or 6 end
      if index == 5 or index == 6 or index == 7 or index == 8 or index == 10 then return 3 end
      if common then return mix == 0 and 11 or 6 end
    else
      if index == 12 or index == 13 or index == 15 or index == 16 or index == 17 then return 3 end
      if common then return mix == 0 and 17 or 13 end
    end
    return nil
  end
  function HC6_OscStartIndex()
    local target = ({"Osc1 Wave Select", "Osc2 Wave Select", "Osc3 Volume"})[HC_OL_osc]
    for index, name in ipairs(HC6_Menus["OSC"] or {}) do
      if name == target then return index end
    end
    return 1
  end
  function HC6_FilterEditTarget()
    if HC6_Mode ~= "menu" or HC6_Group ~= "FILTER" then return nil end
    local function readValid(name)
      local ok, value, info = pcall(function() return params.get(name), params.getInfo(name) end)
      if not ok or type(value) ~= "number" or value % 1 ~= 0 or type(info) ~= "table"
          or type(info.min) ~= "number" or type(info.max) ~= "number"
          or value < info.min or value > info.max then return nil end
      return value
    end
    local vocoder = readValid("Vocoder Mode")
    local filter = readValid("Filter1 Mode")
    if vocoder == nil or filter == nil then return nil end
    local index = HC6_Index
    if index == 20 then return vocoder == 0 and 7 or 29 end
    if index == 7 then return vocoder == 0 and 19 or 29 end
    if index == 19 then
      if vocoder ~= 0 then return 29 end
      local ok, raw = pcall(function() return params.get("Foot Controller") end)
      if not ok or type(raw) ~= "number" or raw % 1 ~= 0 or raw < 0 or raw > 127 then return nil end
      local selector = raw % 4
      if selector == 1 then return 4 end
      if selector == 2 or selector == 3 then return 27 end
      return nil
    end
    if index == 4 or index == 13 then return vocoder == 0 and 27 or 29 end
    if index == 27 then return 29 end
    if index == 29 or index == 8 or index == 17 or index == 21 or index == 22 then
      if filter >= 0 and filter <= 3 then return 20 end
      return vocoder == 0 and 7 or 29
    end
    return nil
  end
  function HC6_FilterStartIndex()
    local target = ({"Filter1 Mode", "Filter2 Mode"})[HC_R_filter]
    for index, name in ipairs(HC6_Menus["FILTER"] or {}) do
      if name == target then return index end
    end
    return 1
  end
  function HC6_LfoStartIndex()
    local target = ({"Lfo1 Shape", "Lfo2 Shape", "Lfo3 Shape"})[HC_OL_lfo]
    for index, name in ipairs(HC6_Menus["LFO"] or {}) do
      if name == target then return index end
    end
    return 1
  end
  function HC6_OpenMenu(group)
    if HC6_Menus[group] == nil then return end
    local romIndex = nil
    if group == "SYSTEM" then
      local mode = HC6_SystemGetPlayMode()
      if mode == 1 or mode == 2 then
        romIndex = HC6_SystemFindFirstPage(mode, HC6_SystemGetControllerFlag(), nil, HC6_SystemGetBankLimit(), HC6_SystemGetBootFlag())
        if type(romIndex) ~= "number" or romIndex % 1 ~= 0
            or romIndex < 0 or romIndex > 54 then return end
        if HC6_SystemResolvePage(romIndex) == nil then return end
      elseif mode ~= 0 then
        return
      end
    end
    HC6_SystemRomIndex = romIndex
    HC6_ActiveKnob = nil
    HC6_Group = group
    HC6_Mode = "menu"
    HC6_EffectsOrigin = group == "EFFECTS" and ({[2]=7, [3]=8})[HC_B_fxSelected] or nil
    HC6_Index = 1
    if group == "OSC" then
      HC6_Index = HC6_OscStartIndex()
    elseif group == "FILTER" then
      HC6_Index = HC6_FilterStartIndex()
    elseif group == "LFO" and HC_OL_lfo >= 1 and HC_OL_lfo <= 3 then
      HC6_Index = HC6_LfoStartIndex()
    elseif group == "DELAY/REV" then
      HC6_Index = 9
    elseif group == "EFFECTS" then
      local target = ({"Distortion Curve", "Phaser Mix", "Chorus Mix"})[HC_B_fxSelected]
      for index, name in ipairs(HC6_Menus[group]) do
        if name == target then
          HC6_Index = index
          break
        end
      end
    end
    HC6_BindSelected()
    HC6_Draw()
  end
  -- Local SHAPE selection uses the existing menu, listener and LCD layout.
  function HC6_ShowLfoShape()
    if HC_OL_lfo == 4 then
      if HC6_Listener ~= nil then params.removeListener(HC6_Listener) end
      HC6_Listener, HC6_CurrentParam = nil, nil
      HC6_Mode, HC6_Group = "home", "PATCH"
      HC6_Draw()
      return
    end
    local p = "Lfo" .. HC_OL_lfo .. " Shape"
    if not HC6_Valid(p) then return end
    HC6_Menus["LFO SHAPE"] = {p}
    HC6_OpenMenu("LFO SHAPE")
  end
  function HC6_MenuStep(delta, groupsOnly)
    if HC6_StoreDialog ~= nil then HC6_StoreStep(delta, false); return end
    if HC6_SyncPlayMode() then HC6_Draw(); return end
    -- OS6.6 home PARAMETER/BANK is not a menu-open action.
    if HC6_Mode ~= "menu" then
      local mode = HC6_SystemGetPlayMode()
      if (mode == 0 or mode == 1 or mode == 2) and params.stepSingleBank ~= nil then
        params.stepSingleBank(delta)
      end
      return
    end
    if HC6_Group == "SYSTEM" and HC6_SystemRomIndex ~= nil then
      if groupsOnly then return end
      local mode = HC6_SystemGetPlayMode()
      if mode ~= 1 and mode ~= 2 then return end
      local ok, keybMode = pcall(function() return params.get("Keyb Mode", 0) end)
      if not ok or (keybMode ~= 0 and keybMode ~= 1) then keybMode = nil end
      local target = HC6_SystemFindParameterPage(HC6_SystemRomIndex, delta, mode, HC6_SystemGetControllerFlag(), keybMode, HC6_SystemGetBankLimit(), HC6_SystemGetBootFlag())
      if type(target) ~= "number" or target % 1 ~= 0
          or target < 0 or target > 54 then return end
      HC6_SystemRomIndex = target
      HC6_BindSelected()
      HC6_Draw()
      return
    end
    local list = HC6_Menus[HC6_Group]
    if list == nil or #list == 0 then return end
    if HC6_Group == "MAIN" then
      local index = HC6_Index
      for _ = 1, #list do
        index = index + delta
        -- OS6.6: PARAMETER stops at the boundary; repeated EDIT wraps between group starts.
        if not groupsOnly and (index < 1 or index > #list) then return end
        index = ((index - 1) % #list) + 1
        if HC6_PageValid(index, groupsOnly) then
          HC6_Index = index
          HC6_BindSelected()
          HC6_Draw()
          return
        end
      end
      return
    end
    -- OS6.6 4AAC/4ADD -> 4A8A/4A96: stop when no valid page remains.
    local index = HC6_Index
    for _ = 1, #list do
      index = index + delta
      if index < 1 or index > #list then return end
      if HC6_Valid(list[index]) then
        HC6_Index = index
        HC6_BindSelected()
        HC6_Draw()
        return
      end
    end
  end
  function HC6_Adjust(delta, original)
    if HC6_StoreDialog ~= nil then HC6_StoreStep(delta, true); return end
    if HC6_SyncPlayMode() then HC6_Draw(); return end
    if HC6_Mode ~= "menu" then
      local mode = HC6_SystemGetPlayMode()
      if mode == 0 or mode == 1 then
        if mode == 0 then
          -- The patch-manager path wraps before Controller::selectNext/PrevPreset.
          -- Stop hardware VALUE at the native SINGLE endpoints before clicking it.
          local ok, program = pcall(function() return params.get("C_Undefined102", 0) end)
          if not ok or type(program) ~= "number" or program % 1 ~= 0
              or program < 0 or program > 127 then return end
          if (delta < 0 and program == 0) or (delta > 0 and program == 127) then return end
        end
        -- The native Osirus preset arrows own bank/program loading and edit buffers.
        -- Never treat a HOME VALUE press as a synth-parameter adjustment.
        local part = HC6_SystemGetCurrentPart()
        local id = delta < 0 and "PresetPrev" or "PresetNext"
        local buttons = {}
        for _, element in ipairs(document:GetElementsByTagName("div")) do
          if element:GetAttribute("id") == id then buttons[#buttons + 1] = element end
        end
        if part ~= nil and part >= 0 and part < 16 and #buttons == 16 then
          buttons[part + 1]:Click()
          HC6_LastPatch = HC6_NativeText("PatchName")
          HC6_LastFocused, HC6_LastFocusValue = "", ""
          HC6_Draw()
        end
        return
      end
      if mode == 2 and params.stepMultiProgram ~= nil then
        params.stepMultiProgram(delta)
      end
      return
    end
    local p = HC6_CurrentParam
    local info = p ~= nil and params.getInfo(p) or nil
    if info == nil then return end
    local v = tonumber(params.get(p))
    local lo, hi = tonumber(info.min), tonumber(info.max)
    if v == nil or lo == nil or hi == nil then return end
    if HC6_Group == "LFO SHAPE" and v >= 4 then
      lo, hi = math.max(lo, 4), math.min(hi, 67)
    end
    params.set(p, math.max(lo, math.min(hi, v + delta)))
    HC6_Draw()
  end
  function HC6_Tick(event)
    local now = tonumber(event.parameters['time']) or 0
    if now < HC6_NextTick then return end
    HC6_NextTick = now + 0.20
    if HC6_SyncPlayMode() then HC6_Draw() end
    HC6_DelayCopyStep()
    if HC6_StoreDialog ~= nil then HC6_Draw(); return end
    local patch = HC6_NativeText("PatchName")
    local label = HC6_NativeText("FocusedParameterName")
    local value = HC6_NativeText("FocusedParameterValue")
    if params.get("Knob Display") == 0 or label == "" or patch ~= HC6_LastPatch
        or (HC6_ActiveKnob ~= nil and label ~= HC6_ActiveKnob:GetAttribute("param")) then
      HC6_ActiveKnob = nil
    end
    -- Native focus also follows mouseover; only input events may select a hardware knob.
    label, value = "", ""
    if patch ~= HC6_LastPatch or label ~= HC6_LastFocused or value ~= HC6_LastFocusValue then
      HC6_LastPatch, HC6_LastFocused, HC6_LastFocusValue = patch, label, value
    end
    if HC6_Mode == "home" or (HC6_Mode == "menu" and (HC6_Group == "MAIN"
        or (HC6_Group == "SYSTEM" and HC6_CurrentParam == "Master Tune"))) then HC6_Draw() end
  end
  function HC6_Init()
    for _,name in ipairs({"drag", "mousescroll", "dblclick"}) do
      document:AddEventListener(name, HC6_KnobInput, true)
    end
    -- Wrap only the four existing Lua entry points. No DOM reparenting,
    -- no native Osirus control IDs/handlers altered, no new onframe handler.
    local previousBank = HC_R_Bank
    HC_R_Bank = function(delta) HC6_MenuStep(delta) end
    local previousValue = HC_R_Value
    HC_R_Value = function(delta) HC6_Adjust(delta, previousValue) end
    local previousEdit = HC_R_ToggleEdit
    HC_R_ToggleEdit = function(group, led)
      if HC6_StoreDialog ~= nil then return end
      if HC6_SyncPlayMode() then HC6_Draw(); return end
      if group == "delay" and HC6_Mode == "menu" and HC6_Group == "DELAY/REV" and HC6_Index == 9 then
        if HC6_DelayCopyKind ~= nil then
          HC6_DelayCopyKind, HC6_DelayCopyMode = nil, nil
          HC6_Draw()
          return
        end
        local ok, mode = pcall(function() return params.get("Delay/Reverb Mode") end)
        if ok and type(mode) == "number" and mode % 1 == 0 and mode >= 1 and mode <= 26 then
          HC6_DelayCopyKind = mode >= 2 and mode <= 4 and "Revrb" or "Delay"
          HC6_DelayCopyMode = mode
          HC6_Draw()
          return
        end
      end
      if group == "delay" and HC6_Mode == "menu" and HC6_Group == "DELAY/REV"
          and params.get("Delay/Reverb Mode") == 0 then
        HC6_Index = 9
        HC6_BindSelected()
        HC6_Draw()
        return
      end
      if group == "arp" and HC6_Mode == "menu" and HC6_Group == "ARP" then
        HC6_Index = 4
        HC6_BindSelected()
        HC6_Draw()
        return
      end
      if group == "lfo" and HC6_Mode == "menu" and HC6_Group == "MOD EDIT" then
        local mode = HC6_SystemGetPlayMode()
        local savedIndex = HC6_LfoEditPage[mode]
        HC6_OpenMenu("LFO")
        HC6_Index = HC6_ValidLfoEditPage(savedIndex) and savedIndex or 7
        HC6_BindSelected()
        HC6_Draw()
        return
      end
      if group == "lfo" and HC6_Mode == "menu" and HC6_Group == "LFO" then
        local index = HC6_Index
        if type(index) == "number" and index % 1 == 0 and index >= 1 and index <= 23 then
          -- Skin-only pages follow their LFO family in the ROM-G4 group cycle.
          HC6_Index = index <= 8 and 15 or (index <= 16 and 22 or 7)
          HC6_BindSelected()
          HC6_Draw()
          return
        end
      end
      if group == "filter" and HC6_Mode == "menu" and HC6_Group == "FILTER" then
        local target = HC6_FilterEditTarget()
        if target ~= nil then
          HC6_Index = target
          HC6_BindSelected()
          HC6_Draw()
          return
        end
      end
      if group == "osc" and HC6_Mode == "menu" and HC6_Group == "OSC" then
        local target = ({
          [17]=18, [4]=18, [18]=15, [19]=15, [8]=15, [12]=15,
          [11]=15, [15]=16, [16]=28, [28]=26, [26]=17
        })[HC6_Index]
        if target ~= nil then
          HC6_Index = target
          HC6_BindSelected()
          HC6_Draw()
          return
        end
      end
      if group == "fx" and HC6_Mode == "menu" and HC6_Group == "EFFECTS" then
        local target = HC6_EffectsEditTarget()
        if target ~= nil then
          HC6_Index = target
          HC6_BindSelected()
          HC6_Draw()
          return
        end
      end
      if group == "system" and HC6_Mode == "menu" and HC6_Group == "SYSTEM"
          and HC6_SystemRomIndex ~= nil then
        local mode = HC6_SystemGetPlayMode()
        if mode ~= 0 and mode ~= 1 and mode ~= 2 then return end
        if mode == 1 or mode == 2 then
          local target = HC6_SystemFindNextGroup(HC6_SystemRomIndex, mode, HC6_SystemGetControllerFlag(), nil, HC6_SystemGetBankLimit(), HC6_SystemGetBootFlag())
          if type(target) == "number" and target % 1 == 0 and target >= 0 and target <= 54 then
            HC6_SystemRomIndex = target
            HC6_BindSelected()
            HC6_Draw()
          end
          return
        end
      end
      previousEdit(group, led)
      if group == "general" then
        if HC6_Mode == "menu" and HC6_Group == "MAIN" then
          HC6_MenuStep(1, true)
        else
          HC6_OpenMenu("MAIN")
        end
        HC_R_edit.general = true
        HC_R_SetLed(led, true)
        return
      end
      local mapping = {
        system = "SYSTEM", osc = "OSC", filter = "FILTER",
        lfo = "LFO", fx = "EFFECTS", delay = "DELAY/REV", arp = "ARP"
      }
      local section = mapping[group]
      if group == "lfo" and HC_OL_lfo == 4 then section = "MOD EDIT" end
      if section ~= nil and HC6_Mode == "menu" and HC6_Group == section then
        HC6_Mode = "home"
        HC_R_edit.general = false
        HC_R_SetLed(68, false)
        if HC6_Listener ~= nil then
          params.removeListener(HC6_Listener)
          HC6_Listener = nil
        end
        HC6_Draw()
        HC_R_SetLed(led, false)
      else
        HC6_OpenMenu(section or "PATCH")
        HC_R_SetLed(led, true)
      end
    end
    local previousFrame = HC5_Frame
    HC5_Frame = function(event)
      if previousFrame ~= nil then previousFrame(event) end
      HC6_Tick(event)
    end
    params.onPartChanged(function(part)
      if (HC6_ViewPartEvents[part] or 0) > 0 then
        HC6_ViewPartEvents[part] = HC6_ViewPartEvents[part] - 1
        return
      end
      if HC6_ViewChanging then return end
      HC6_ActiveKnob = nil
      if HC6_Mode == "menu" and HC6_Group == "EFFECTS" and HC6_Index == 25 then
        HC6_BindSelected()
      end
      if HC6_Mode == "menu" and HC6_Group == "LFO SHAPE" then
        HC6_ShowLfoShape()
      else
        HC6_Draw()
      end
    end)
    params.onChange("Knob Mode", function()
      if HC6_Mode == "menu" and HC6_Group == "SYSTEM"
          and (HC6_SystemRomIndex == 0 or HC6_SystemRomIndex == 43) then HC6_Draw() end
    end, 0)
    params.onChange("LCD Contrast", HC6_UpdateLcdContrast, 0)
    HC6_UpdateLcdContrast()
    HC6_LastPatch = HC6_NativeText("PatchName")
    HC6_LastFocused = ""
    HC6_LastFocusValue = ""
    HC6_Draw()
  end
</script>
<!-- HC6_LCD_SCRIPT_END -->
<!-- HC7_LCD_SCRIPT_BEGIN: Replace v6 text rasterization only. -->
<script>
  -- 18 x 2 visible 5x8 rasters; firmware still supplies only 16 characters per line.
  -- Preserve the existing mapping from character 1 to raster 1. Slots 17/18 stay blank;
  -- their hardware placement relative to the firmware is not established by the reference.
  -- The existing HC6_Draw, menu/page navigation, knobs and params stay untouched.
  local HC7_PreviousLCDText = HC6_Text
  function HC6_UpdateLcdContrast()
    local ok, value = pcall(function() return params.get("LCD Contrast", 0) end)
    if not ok or type(value) ~= "number" or value % 1 ~= 0 or value < 0 or value > 127 then return end
    -- Visual skin approximation, not an OS6.6 contrast curve. Includes dim dots and glow.
    local opacity = tostring(0.25 + 0.75 * value / 127)
    for _, id in ipairs({"HC6_LcdTop", "HC6_LcdBottom"}) do
      local display = document:GetElementById(id)
      if display ~= nil then display.style.opacity = opacity end
    end
  end
  function HC6_Text(id, value, partGlyph, bottomGlyph, cursor)
    if id ~= "HC6_LcdTop" and id ~= "HC6_LcdBottom" then
      return HC7_PreviousLCDText(id, value)
    end
    local display = document:GetElementById(id)
    if display == nil then return end
    -- STORE names are raw ROM-range bytes, not HTML: preserve literal <, > and &.
    local s = cursor ~= nil and tostring(value or "") or HC6_Clean(value or "")
    s = s:gsub("ä", "ae"):gsub("ö", "oe"):gsub("ü", "ue")
         :gsub("Ä", "Ae"):gsub("Ö", "Oe"):gsub("Ü", "Ue")
         :gsub("ß", "ss"):gsub("↓", "v"):gsub("↑", "^")
    -- Use all 18 visible columns; mark overflow in the final column.
    if #s > 18 then s = string.sub(s, 1, 17) .. ">" end
    local bits = {}
    local pitch = 354 / 18
    for col=1,18 do
      if col == 1 and id == "HC6_LcdTop" and partGlyph ~= nil then
        bits[#bits+1] = string.format(
          '<img sprite="HC8_part%02d" style="position:absolute;left:0dp;top:0dp;width:18dp;height:31dp;pointer-events:none;"/>',
          partGlyph + 1)
      elseif col == 16 and id == "HC6_LcdBottom"
          and (bottomGlyph == 0x03 or bottomGlyph == 0x04
            or bottomGlyph == 0x05 or bottomGlyph == 0x06) then
        -- OS6.6 CGRAM 03-06: original bitmaps at 8228, 8230, 8238, 8240.
        -- Separate from text cleaning, so all other control characters keep their handling.
        bits[#bits+1] = string.format(
          '<img sprite="HC8_cgram%02d" style="position:absolute;left:%.6fdp;top:0dp;width:18dp;height:31dp;pointer-events:none;"/>',
          bottomGlyph, (col-1)*pitch)
      else
      local c = string.byte(s, col) or 32
      if c < 32 or c > 126 then c=63 end
      bits[#bits+1] = string.format(
        '<img sprite="HC7_chr%d" style="position:absolute;left:%.6fdp;top:0dp;width:18dp;height:31dp;pointer-events:none;"/>',
        c, (col-1)*pitch)
      end
    end
    if id == "HC6_LcdTop" and cursor ~= nil and cursor >= 3 and cursor <= 16 then
      -- ROM 0C2A enables the HD44780 underline cursor (command 0Eh).
      -- Draw it separately: no substitute character or atlas change.
      bits[#bits+1] = string.format(
        '<div style="position:absolute;left:%.6fdp;top:27dp;width:12dp;height:2.4dp;background-color:#fc695d;pointer-events:none;"/>',
        (cursor-1)*pitch+3)
    end
    display.inner_rml = table.concat(bits)
  end
</script>
<!-- HC7_LCD_SCRIPT_END -->
</head>
