<rml>
	<head>
		<link type="text/template" href="tus_colorpicker.rml"/>
		<link type="text/template" href="tus_patchmanager.rml"/>
		<link type="text/rcss" href="tus_default.rcss"/>
		<link type="text/rcss" href="tus_juceskin.rcss"/>
		<link type="text/rcss" href="VirusC_HardwareC.rcss"/>
	<!-- HC_FILTER_SCRIPT_BEGIN -->
<script>
  -- v1: preserve the 4 conventional modes (LP, HP, BP, BS).
  -- Filter1 additionally has analog modes 4-7; those light none of these 4 LEDs.
  function HC_Filter_Update(which, rawValue)
    local val = tonumber(rawValue)
    if val == nil then return end
    local modes = {"LP", "HP", "BP", "BS"}
    for index = 1, 4 do
      local led = document:GetElementById("HC_Filter" .. which .. "_" .. modes[index])
      if led ~= nil then
        led.style.opacity = (val == index - 1) and "1" or "0"
      end
    end
  end

  function HC_Filter_Cycle(which)
    local parameter = (which == 1) and "Filter1 Mode" or "Filter2 Mode"
    local oldValue = tonumber(params.get(parameter))
    if oldValue == nil then return end
    -- First pass: only LP/HP/BP/BS, matching the four marked LEDs.
    params.set(parameter, (oldValue + 1) % 4)
  end

  function HC_Filter_Init()
    HC_Filter_Update(1, params.get("Filter1 Mode"))
    HC_Filter_Update(2, params.get("Filter2 Mode"))
    params.onChange("Filter1 Mode", function(value)
      HC_Filter_Update(1, value)
    end)
    params.onChange("Filter2 Mode", function(value)
      HC_Filter_Update(2, value)
    end)
  end
</script>
<!-- HC_FILTER_SCRIPT_END -->
<!-- HC_OSCLFO_SCRIPT_BEGIN -->
<script>
  -- UI-only selection state: the Virus C oscillator/LFO panel buttons select
  -- which group the physical controls address. Dynamic re-binding of the
  -- shared knobs is NOT in this patch.
  HC_OL_osc = 1
  HC_OL_lfo = 1
  HC_OL_lastOsc3Mode = 1

  function HC_OL_Led(name, on)
    local element = document:GetElementById("HC_OL_" .. name)
    if element ~= nil then element.style.opacity = on and "1" or "0" end
  end

  function HC_OL_SelectOsc(which)
    HC_OL_osc = which
    for k=1,3 do HC_OL_Led("OscSel" .. k, k == which) end
  end

  function HC_OL_SelectLfo(which)
    HC_OL_lfo = which
    for k=1,4 do HC_OL_Led("LfoSel" .. k, k == which) end
    HC_OL_RefreshShape()
  end

  function HC_OL_NextLfo()
    HC_OL_SelectLfo((HC_OL_lfo % 4) + 1)
  end

  function HC_OL_RefreshShape()
    local v = nil
    if HC_OL_lfo ~= 4 then v = tonumber(params.get("Lfo" .. HC_OL_lfo .. " Shape")) end
    -- Shape codes 0=sine 1=triangle 2=saw 3=square.
    -- 4/5 are random waveforms; >=6 are extended cyclic waveforms.
    local names={"LfoSine","LfoTri","LfoSaw","LfoRect","LfoWave"}
    for k=1,5 do
      local active = (v ~= nil) and ((k <= 4 and v == k-1) or (k == 5 and v >= 4))
      HC_OL_Led(names[k],active)
    end
  end

  function HC_OL_NextLfoShape()
    if HC_OL_lfo == 4 then return end  -- MOD matrix has no LFO waveform
    local p = "Lfo" .. HC_OL_lfo .. " Shape"
    local v = tonumber(params.get(p))
    if v == nil then return end
    params.set(p,(v+1)%6)
  end

  function HC_OL_RefreshOsc3(raw)
    local v=tonumber(raw)
    if v==nil then return end
    if v>0 then HC_OL_lastOsc3Mode=v end
    HC_OL_Led("Osc3On",v>0)
  end

  function HC_OL_ToggleOsc3()
    local v=tonumber(params.get("Osc3 Mode"))
    if v==nil then return end
    if v>0 then
      HC_OL_lastOsc3Mode=v
      params.set("Osc3 Mode",0)
    else
      params.set("Osc3 Mode",HC_OL_lastOsc3Mode)
    end
  end

  function HC_OL_RefreshSync(raw)
    local v=tonumber(raw)
    if v ~= nil then HC_OL_Led("OscSync",v ~= 0) end
  end

  function HC_OL_ToggleSync()
    local v=tonumber(params.get("Osc2 Sync"))
    if v~=nil then params.set("Osc2 Sync",v==0 and 1 or 0) end
  end


  -- ARP On/Off is a real firmware parameter. Preserve a previously selected mode.
  HC_B_lastArpMode = 1
  HC_B_fxSelected = 1
  function HC_B_Led(name, enabled)
    local e = document:GetElementById("HC_B_" .. name)
    if e ~= nil then e.style.opacity = enabled and "1" or "0" end
  end
  function HC_B_RefreshArp(v)
    local n = tonumber(v)
    if n == nil then return end
    if n > 0 then HC_B_lastArpMode = n end
    HC_B_Led("ArpOn", n > 0)
  end
  function HC_B_ToggleArp()
    local n = tonumber(params.get("Arp Mode"))
    if n == nil then return end
    if n > 0 then
      HC_B_lastArpMode = n
      params.set("Arp Mode", 0)
    else
      params.set("Arp Mode", HC_B_lastArpMode)
    end
  end
  -- Effect SELECT is editor selection only; effect DSP routing isn't changed.
  function HC_B_SelectFx(which)
    HC_B_fxSelected = which
    HC_B_Led("FxDist", which == 1)
    HC_B_Led("FxPha", which == 2)
    HC_B_Led("FxCho", which == 3)
  end
  function HC_B_NextFx()
    HC_B_SelectFx((HC_B_fxSelected % 3) + 1)
  end
  function HC_B_Init()
    HC_B_RefreshArp(params.get("Arp Mode"))
    params.onChange("Arp Mode", function(v) HC_B_RefreshArp(v) end)
    HC_B_SelectFx(1)
  end

  function HC_OL_Init()
    HC_B_Init()
    HC_OL_SelectOsc(1)
    HC_OL_SelectLfo(1)
    HC_OL_RefreshOsc3(params.get("Osc3 Mode"))
    HC_OL_RefreshSync(params.get("Osc2 Sync"))
    params.onChange("Osc3 Mode",function(v) HC_OL_RefreshOsc3(v) end)
    params.onChange("Osc2 Sync",function(v) HC_OL_RefreshSync(v) end)
    for k=1,3 do
      params.onChange("Lfo" .. k .. " Shape",function(v) HC_OL_RefreshShape() end)
    end
  end
</script>
<!-- HC_OSCLFO_SCRIPT_END -->
<!-- HC4_SCRIPT_BEGIN -->
<script>
  -- Safe v4 addition. Never relocate/duplicate native Osirus controls.
  -- All clickable areas are ordinary RmlUi divs, with valid inline Lua.
  HC_R_edit = {}
  HC_R_filter = 1
  HC_R_bank = 1
  HC_R_lastParam = "Cutoff"
  HC_R_undo = nil
  HC_R_assignSlot = 1
  HC_R_choices = {
    "Cutoff", "Filter1 Resonance", "Cutoff2", "Filter2 Resonance",
    "Osc1 Shape", "Osc2 Detune", "Osc2 FM Amount", "Lfo1 Rate",
    "Lfo2 Rate", "Lfo3 Rate", "Arp Mode", "Delay/Reverb Mode"
  }

  function HC_R_SetLed(number, enabled)
    local e = document:GetElementById(string.format("HC_R_LED_%04d", number))
    if e ~= nil then e.style.opacity = enabled and "1" or "0" end
  end
  function HC_R_ToggleEdit(group, led)
    HC_R_edit[group] = not HC_R_edit[group]
    HC_R_SetLed(led, HC_R_edit[group])
  end
  function HC_R_ChooseParam(name)
    if params.getInfo(name) ~= nil then HC_R_lastParam = name end
  end
  function HC_R_Value(delta)
    local p = HC_R_lastParam
    local info = params.getInfo(p)
    if not info then return end
    local v,lo,hi = tonumber(params.get(p)),tonumber(info.min),tonumber(info.max)
    if not v or not lo or not hi then return end
    params.set(p, math.max(lo,math.min(hi,v+delta)))
  end
  function HC_R_Bank(delta)
    HC_R_bank = ((HC_R_bank-1+delta) % #HC_R_choices)+1
    HC_R_ChooseParam(HC_R_choices[HC_R_bank])
  end
  function HC_R_Transpose(direction)
    -- Virus C Transpose parameter is signed MIDI byte (center 64).
    local p = "Transpose"
    local v = tonumber(params.get(p))
    local info = params.getInfo(p)
    if not v or not info then return end
    params.set(p,math.max(info.min,math.min(info.max,v+12*direction)))
    HC_R_ChooseParam(p)
  end
  function HC_R_ShowTranspose(raw)
    local v=tonumber(raw)
    if not v then return end
    local octave=math.max(-2,math.min(2,math.floor((v-64)/12+0.5)))
    for i=-2,2 do HC_R_SetLed(73+i,i==octave) end
  end
  function HC_R_ShowTempo(raw)
    -- Indicates nonzero BPM parameter, not a rhythmic blink.
    local n=tonumber(raw)
    HC_R_SetLed(70,n~=nil and n>0)
  end
  function HC_R_Randomize()
    -- Limited six-parameter variation only; not hardware RANDOM.
    local names={"Osc1 Shape","Osc2 Detune","Cutoff","Filter1 Resonance","Lfo1 Rate","Osc2 FM Amount"}
    local saved={}
    for _,p in ipairs(names) do
      local info=params.getInfo(p)
      if info then
        local v=tonumber(params.get(p))
        local lo,hi=tonumber(info.min),tonumber(info.max)
        if v and lo and hi and hi>=lo then
          saved[p]=v
          local span=hi-lo
          local change=math.floor((math.random()*2-1)*span*0.15+0.5)
          params.set(p,math.max(lo,math.min(hi,v+change)))
        end
      end
    end
    HC_R_undo=saved
  end
  function HC_R_Undo()
    if HC_R_undo == nil then return end
    for p,v in pairs(HC_R_undo) do params.set(p,v) end
    HC_R_undo=nil
  end
  function HC_R_SelectFilter(which)
    HC_R_filter=which
    HC_R_SetLed(126,which==2)
    HC_R_SetLed(127,which==1)
    HC_R_ChooseParam(which==1 and "Filter1 Mode" or "Filter2 Mode")
  end
  -- The MOD ASSIGN 1..6 LEDs are local editing selection, not DSP state.
  function HC_R_ShowAssign()
    for i=1,6 do HC_R_SetLed(36+i,i==HC_R_assignSlot) end
  end
  function HC_R_NextLfoDestination()
    local selected=HC_OL_lfo or 1
    if selected==4 then
      HC_R_assignSlot=(HC_R_assignSlot % 6)+1
      HC_R_ShowAssign()
      return
    end
    local p=({"LFO1 Assign Dest","LFO2 Assign Dest","Lfo3 Destination"})[selected]
    if not p then return end
    local info=params.getInfo(p)
    local v=tonumber(params.get(p))
    if not info or not v then return end
    local lo,hi=tonumber(info.min),tonumber(info.max)
    if not lo or not hi or hi<=lo then return end
    params.set(p,v>=hi and lo or v+1)
  end
  -- Fixed LFO modulation amount LEDs: centered bipolar values have neutral 64.
  HC_R_amounts={
    {20,"Osc1 Lfo1 Amount"},{21,"Osc2 Lfo1 Amount"},{22,"PW Lfo1 Amount"},
    {23,"Reso Lfo1 Amount"},{24,"FiltGain Lfo1 Amount"},
    {26,"Cutoff1 Lfo2 Amount"},{27,"Cutoff2 Lfo2 Amount"},
    {28,"Shape Lfo2 Amount"},{29,"FM Lfo2 Amount"},{30,"Pan Lfo2 Amount"}
  }
  function HC_R_ShowAmount(index,raw)
    local v=tonumber(raw)
    HC_R_SetLed(index,v~=nil and v~=64)
  end
  function HC_R_ShowAssignAmount(index,dest,amount)
    local d,a=tonumber(dest),tonumber(amount)
    HC_R_SetLed(index,d~=nil and a~=nil and d~=0 and a~=64)
  end
  -- LFO3 Destination has six actual states: Osc1 / Osc1+2 / Osc2 /
  -- PW1 / PW1+2 / PW2. LED 36 (SYNC PHASE) has no equivalent here.
  function HC_R_ShowLfo3(raw)
    local v=tonumber(raw)
    HC_R_SetLed(32,v==0 or v==1)
    HC_R_SetLed(33,v==1 or v==2)
    HC_R_SetLed(34,v==3 or v==4)
    HC_R_SetLed(35,v==4 or v==5)
  end
  function HC_R_Init()
    HC_R_SelectFilter(1)
    HC_R_ShowAssign()
    HC_R_ShowTranspose(params.get("Transpose"))
    HC_R_ShowTempo(params.get("Clock Tempo"))
    for _,row in ipairs(HC_R_amounts) do
      local idx,p=row[1],row[2]
      HC_R_ShowAmount(idx,params.get(p))
      params.onChange(p,function(value) HC_R_ShowAmount(idx,value) end)
    end
    HC_R_ShowAssignAmount(25,params.get("LFO1 Assign Dest"),params.get("LFO1 Assign Amount"))
    HC_R_ShowAssignAmount(31,params.get("LFO2 Assign Dest"),params.get("LFO2 Assign Amount"))
    local function refresh1() HC_R_ShowAssignAmount(25,params.get("LFO1 Assign Dest"),params.get("LFO1 Assign Amount")) end
    local function refresh2() HC_R_ShowAssignAmount(31,params.get("LFO2 Assign Dest"),params.get("LFO2 Assign Amount")) end
    params.onChange("LFO1 Assign Dest",refresh1)
    params.onChange("LFO1 Assign Amount",refresh1)
    params.onChange("LFO2 Assign Dest",refresh2)
    params.onChange("LFO2 Assign Amount",refresh2)
    HC_R_ShowLfo3(params.get("Lfo3 Destination"))
    params.onChange("Lfo3 Destination",function(v) HC_R_ShowLfo3(v) end)
    params.onChange("Transpose",function(v) HC_R_ShowTranspose(v) end)
    params.onChange("Clock Tempo",function(v) HC_R_ShowTempo(v) end)
    -- LEDs 36 / 76 / 77 left off because these native states lack
    -- a reliable firmware-to-LED mapping via this Lua layer.
  end
</script>
<!-- HC4_SCRIPT_END -->


<!-- HC5_SCRIPT_BEGIN -->
<script>
  -- v5: change only visibility of ordinary, independently parameter-bound knobs.
  -- No native Osirus control is relocated, reparented or dynamically rebound.
  function HC5_ShowContext()
    local osc = tonumber(HC_OL_osc) or 1
    local lfo = tonumber(HC_OL_lfo) or 1
    local fx = tonumber(HC_B_fxSelected) or 1
    local revMode = tonumber(params.get("Delay/Reverb Mode")) or 0
    local delay = (revMode >= 2 and revMode <= 4) and 2 or 1
    for _,row in ipairs(HC5_Groups) do
      local id,group,variant = row[1],row[2],row[3]
      local show = group == "always"
        or (group == "osc" and variant == osc)
        or (group == "detune" and variant == (osc == 3 and 3 or 1))
        or (group == "lfo" and variant == lfo)
        or (group == "fx" and variant == fx)
        or (group == "delay" and variant == delay)
      local e = document:GetElementById(id)
      if e ~= nil then e.style.display = show and "block" or "none" end
    end
  end
  HC5_Groups = {
    {"HC5_K_0011_1", "lfo", 1},
    {"HC5_K_0011_2", "lfo", 2},
    {"HC5_K_0011_3", "lfo", 3},
    {"HC5_K_0054_1", "fx", 1},
    {"HC5_K_0054_2", "fx", 2},
    {"HC5_K_0054_3", "fx", 3},
    {"HC5_K_0055_1", "fx", 1},
    {"HC5_K_0055_2", "fx", 2},
    {"HC5_K_0055_3", "fx", 3},
    {"HC5_K_0056_1", "always", 1},
    {"HC5_K_0057_1", "delay", 1},
    {"HC5_K_0057_2", "delay", 2},
    {"HC5_K_0058_1", "delay", 1},
    {"HC5_K_0058_2", "delay", 2},
    {"HC5_K_0078_1", "always", 1},
    {"HC5_K_0079_1", "always", 1},
    {"HardwareMap_ctrl_0091", "osc", 1},
    {"HC5_K_0091_2", "osc", 2},
    {"HC5_K_0092_1", "osc", 1},
    {"HC5_K_0092_2", "osc", 2},
    {"HC5_K_0092_3", "osc", 3},
    {"HardwareMap_ctrl_0093", "osc", 1},
    {"HC5_K_0093_2", "osc", 2},
    {"HC5_K_0093_3", "osc", 3},
    {"HC5_K_0094_1", "detune", 1},
    {"HC5_K_0094_3", "detune", 3}
  }
  function HC5_Init()
    -- Preserve v2/v4 selector behavior; add only contextual knob visibility.
    local oldOsc = HC_OL_SelectOsc
    HC_OL_SelectOsc = function(n)
      oldOsc(n)
      HC5_ShowContext()
    end
    local oldLfo = HC_OL_SelectLfo
    HC_OL_SelectLfo = function(n)
      oldLfo(n)
      HC5_ShowContext()
    end
    local oldFx = HC_B_SelectFx
    HC_B_SelectFx = function(n)
      oldFx(n)
      HC5_ShowContext()
    end
    params.onChange("Delay/Reverb Mode", function() HC5_ShowContext() end)
    HC5_ShowContext()
  end
  -- Optional hardware-driven LFO activity LEDs (not timer approximations).
  -- leds.get is only available in newer Gearmulator builds.
  function HC5_Frame(event)
    if leds == nil or leds.get == nil then return end
    local names = {"lfo1", "lfo2"}
    local ids = {"HC_R_LED_0009", "HC_R_LED_0010"}
    for i=1,2 do
      local value = leds.get(names[i])
      local e = document:GetElementById(ids[i])
      if value ~= nil and e ~= nil then
        e.style.opacity = tostring(math.max(0,math.min(1,value)) ^ 0.2)
      end
    end
  end
</script>
<!-- HC5_SCRIPT_END -->

<!-- HC6_LCD_SCRIPT_BEGIN -->
<script>
  -- Virus C hardware-panel LCD: editor menu backed by real Osirus parameters.
  -- This is not a firmware display framebuffer or firmware menu protocol.
HC6_Menus = {
  ["PATCH"] = {"Unison Detune", "Unison Pan Spread", "Unison Lfo Phase", "Unison Mode", "Portamento Time", "PulseWidth Velocity", "Transpose", "Bender Range Up", "Bender Range Down", "Bender Scale", "Category1", "Category2"},
  ["OSC"] = {"Osc1 Shape", "Osc1 Pulsewidth", "Osc1 Semitone", "Osc1 Keyfollow", "Osc2 Shape", "Osc2 Pulsewidth", "Osc2 Semitone", "Osc2 Keyfollow", "Osc2 FM Amount", "Osc2 Detune", "FM Filt Env Amt", "Osc2 Filt Env Amt", "Osc3 Semitone", "Osc3 Detune", "Osc3 Volume", "Osc Init Phase", "Osc1 Wave Select", "Osc2 Wave Select", "Osc FM Mode", "Osc3 Mode", "Osc2 Sync", "Osc Balance", "Osc Mainvolume", "Noise Volume", "Ringmodulator Volume", "Noise Color", "Suboscillator Volume", "Suboscillator Shape", "Osc1 Shape Velocity", "Osc2 Shape Velocity", "Fm Amount Velocity"},
  ["FILTER"] = {"Cutoff", "Filter1 Resonance", "Filter1 Env Amt", "Filter1 Keyfollow", "Resonance1 Velocity", "Flt1 EnvAmt Velocity", "Filter1 Mode", "Filter1 Env Polarity", "Cutoff2", "Cutoff2Offset", "Filter2 Resonance", "Filter2 Env Amt", "Filter2 Keyfollow", "Resonance2 Velocity", "Flt2 EnvAmt Velocity", "Filter2 Mode", "Filter2 Env Polarity", "Filter Balance", "Filter Routing", "Saturation Curve", "Filter Keytrack Base", "Filter2 Cutoff Link", "Filter Select", "Filter Env Attack", "Filter Env Decay", "Filter Env Sustain", "Filter Env Sustain Time", "Filter Env Release"},
  ["AMP"] = {"Amp Env Attack", "Amp Env Decay", "Amp Env Sustain", "Amp Env Sustain Time", "Amp Env Release", "Punch Intensity", "Amp Velocity", "Panorama Velocity", "Patch Volume", "Panorama"},
  ["LFO"] = {"Lfo1 Shape", "Lfo1 Clock", "Lfo1 Mode", "Lfo1 Env Mode", "Lfo1 Rate", "Lfo1 Keyfollow", "Lfo1 Symmetry", "Lfo1 Keytrigger", "Lfo2 Shape", "Lfo2 Clock", "Lfo2 Mode", "Lfo2 Env Mode", "Lfo2 Rate", "Lfo2 Keyfollow", "Lfo2 Symmetry", "Lfo2 Keytrigger", "Lfo3 Shape", "Lfo3 Clock", "Lfo3 Mode", "Lfo3 Rate", "Lfo3 Keyfollow", "Lfo3 Fade-In Time", "Lfo3 Destination"},
  ["MOD MATRIX"] = {"Osc1 Lfo1 Amount", "Osc2 Lfo1 Amount", "FiltGain Lfo1 Amount", "LFO1 Assign Amount", "PW Lfo1 Amount", "Reso Lfo1 Amount", "LFO1 Assign Dest", "Cutoff1 Lfo2 Amount", "Cutoff2 Lfo2 Amount", "Pan Lfo2 Amount", "LFO2 Assign Amount", "Shape Lfo2 Amount", "FM Lfo2 Amount", "LFO2 Assign Dest", "Osc Lfo3 Amount", "Assign1 Amount", "Assign1 Source", "Assign1 Destination", "Assign2 Amount1", "Assign2 Source", "Assign2 Destination1", "Assign2 Amount2", "Assign2 Destination2", "Assign3 Amount1", "Assign3 Source", "Assign3 Destination1", "Assign3 Amount2", "Assign3 Destination2", "Assign3 Amount3", "Assign3 Destination3", "Assign 4 Amount", "Assign 4 Source", "Assign 4 Destination", "Assign 5 Amount", "Assign 5 Source", "Assign 5 Destination", "Assign 6 Amount", "Assign 6 Source", "Assign 6 Destination"},
  ["EFFECTS"] = {"Distortion Curve", "Distortion Intensity", "Bass Intensity", "Bass Tune", "Phaser Mode", "Phaser Rate", "Phaser Frequency", "Phaser Depth", "Phaser Feedback", "Phaser Spread", "Phaser Mix", "Chorus Lfo Shape", "Chorus Rate", "Chorus Depth", "Chorus Feedback", "Chorus Delay", "Chorus Mix", "LowEQ Gain", "LowEQ Frequency", "MidEQ Gain", "MidEQ Frequency", "MidEQ Q-Factor", "HighEQ Gain", "HighEQ Frequency", "Effect Send"},
  ["DELAY/REV"] = {"Dly Rate / Rev Decay", "Reverb Damping", "Delay Color", "Delay Time", "Delay Feedback", "Rev Size", "Dly Depth ", "Delay Lfo Shape", "Delay/Reverb Mode", "Delay Clock"},
  ["ARP"] = {"Clock Tempo", "Arp Note Length", "Arp Swing", "Arp Mode", "Arp Pattern Selct", "Arp Octave Range", "Arp Clock", "Arp Hold Enable"},
  ["PART"] = {"Part Output Select", "Part Volume", "Part Transpose", "Part Detune", "Part Low Key", "Part High Key", "Part Midi Channel", "Part Enable"},
  ["SYSTEM"] = {"Input Follower Mode", "Vocoder Mode", "Input Select", "Input Mode", "Master Tune", "Pure Tuning", "Soft Knob-1 Mode", "Soft Knob1 ShortName", "Soft Knob-2 Mode", "Soft Knob2 ShortName", "Key Mode", "Second Output Balance", "Control Smooth Mode", "Note Steal Priority", "Master Volume"},
}
  HC6_Mode = "home"
  HC6_Group = "PATCH"
  HC6_Index = 1
  HC6_CurrentParam = nil
  HC6_Listener = nil
  HC6_NextTick = 0
  HC6_HomeLabel = "Cutoff"
  HC6_LastPatch = ""
  HC6_LastFocused = ""
  HC6_LastFocusValue = ""
  HC6_LastTop = nil
  HC6_LastBottom = nil

  function HC6_Clean(s)
    s = tostring(s or "")
    s = string.gsub(s, "<[^>]*>", "")
    s = string.gsub(s, "&amp;", "&")
    s = string.gsub(s, "&lt;", "<")
    s = string.gsub(s, "&gt;", ">")
    return string.gsub(s, "[%c]", " ")
  end
  function HC6_Encode(s)
    s = HC6_Clean(s)
    s = string.gsub(s, "&", "&amp;")
    s = string.gsub(s, "<", "&lt;")
    return string.gsub(s, ">", "&gt;")
  end
  function HC6_Text(id, value)
    local node = document:GetElementById(id)
    if node ~= nil then node.inner_rml = HC6_Encode(value) end
  end
  function HC6_NativeText(id)
    local el = document:GetElementById(id)
    if (id == "FocusedParameterName" or id == "FocusedParameterValue")
        and el ~= nil and el.style.display == "none" then return "" end
    return el ~= nil and HC6_Clean(el.inner_rml) or ""
  end
  function HC6_ParameterName()
    local list = HC6_Menus[HC6_Group]
    return list ~= nil and list[HC6_Index] or nil
  end
  function HC6_Valid(p)
    if p == nil then return false end
    return params.getInfo(p) ~= nil
  end
  function HC6_BindSelected()
    if HC6_Listener ~= nil then
      params.removeListener(HC6_Listener)
      HC6_Listener = nil
    end
    local name = HC6_ParameterName()
    if not HC6_Valid(name) then
      local list = HC6_Menus[HC6_Group]
      if list ~= nil then
        for i = 1, #list do
          if HC6_Valid(list[i]) then
            HC6_Index = i
            name = list[i]
            break
          end
        end
      end
    end
    HC6_CurrentParam = HC6_Valid(name) and name or nil
    if HC6_CurrentParam ~= nil then
      HC_R_lastParam = HC6_CurrentParam
      HC6_Listener = params.onChange(HC6_CurrentParam, function()
        if HC6_Mode == "menu" then HC6_Draw() end
      end)
    end
  end
  function HC6_Draw()
    local top = ""
    local lower = ""
    if HC6_Mode == "menu" then
      local list = HC6_Menus[HC6_Group] or {}
      top = string.format("%s %d/%d", HC6_Group, HC6_Index, #list)
      local p = HC6_CurrentParam
      if p ~= nil then
        local info = params.getInfo(p)
        local label = info ~= nil and info.displayName or p
        local val = params.getText(p)
        if val == nil or val == "" then val = tostring(params.get(p) or "--") end
        -- Fit parameter and formatted value on a 2-line, narrow display.
        label = HC6_Clean(label)
        val = HC6_Clean(val)
        if #val > 8 then val = string.sub(val, 1, 8) end
        local limit = math.max(6, 23 - #val - 1)
        lower = string.sub(label, 1, limit) .. " " .. val
      else
        lower = "No mapped parameter"
      end
    else
      local part = tonumber(params.getCurrentPart()) or 0
      local patch = HC6_LastPatch
      if patch == "" then patch = "Virus C" end
      top = string.format("P%02d %s", part + 1, patch)
      local label = HC6_LastFocused
      local value = HC6_LastFocusValue
      if label == "" then
        label = HC6_Clean(params.getText("Soft Knob1 ShortName"))
        value = HC6_Clean(params.getText("Soft Knob2 ShortName"))
      end
      if HC6_LastFocused ~= "" then
        label = string.gsub(label, "^Osc%s*([123])%s+Semitones?$", "Osc%1 Semi")
      end
      lower = HC6_Clean(label) .. " " .. HC6_Clean(value)
      if HC6_LastFocused == "" then
        lower = string.format("%-8.8s%8.8s", label, value)
      end
      if HC6_LastFocused ~= "" then
        local text = HC6_Clean(value)
        local shortLabel = string.sub(HC6_Clean(label), 1, math.max(0, 16 - #text - 1))
        lower = (shortLabel ~= "" and shortLabel .. " " or "") .. text
        local waveOsc = string.match(HC6_LastFocused, "^Osc%s*([12])%s+Wave%s+Select$")
        if waveOsc ~= nil then
          lower = string.format("Osc%s%12s", waveOsc, text)
        end
        local detuneOsc = string.match(HC6_LastFocused, "^Osc%s*([23])%s+Detune$")
        local detune = detuneOsc ~= nil and tonumber(params.get("Osc" .. detuneOsc .. " Detune")) or nil
        if detune ~= nil then
          lower = string.format("Detune%s%+9d", detuneOsc, detune)
        end
      end
    end
    top = string.sub(top, 1, 25)
    lower = string.sub(lower, 1, 25)
    if top ~= HC6_LastTop then HC6_Text("HC6_LcdTop", top); HC6_LastTop = top end
    if lower ~= HC6_LastBottom then HC6_Text("HC6_LcdBottom", lower); HC6_LastBottom = lower end
  end
  function HC6_OpenMenu(group)
    if HC6_Menus[group] == nil then return end
    HC6_Group = group
    HC6_Mode = "menu"
    HC6_Index = 1
    HC6_BindSelected()
    HC6_Draw()
  end
  function HC6_MenuStep(delta)
    if HC6_Mode ~= "menu" then HC6_OpenMenu(HC6_Group); return end
    local list = HC6_Menus[HC6_Group]
    if list == nil or #list == 0 then return end
    for _ = 1, #list do
      HC6_Index = ((HC6_Index - 1 + delta) % #list) + 1
      if HC6_Valid(list[HC6_Index]) then break end
    end
    HC6_BindSelected()
    HC6_Draw()
  end
  function HC6_Adjust(delta, original)
    if HC6_Mode ~= "menu" then
      -- Retain established v4 VALUE behavior outside an LCD edit menu.
      if original ~= nil then original(delta) end
      HC6_HomeLabel = HC_R_lastParam or "Cutoff"
      HC6_LastFocused = ""
      HC6_Draw()
      return
    end
    local p = HC6_CurrentParam
    local info = p ~= nil and params.getInfo(p) or nil
    if info == nil then return end
    local v = tonumber(params.get(p))
    local lo, hi = tonumber(info.min), tonumber(info.max)
    if v == nil or lo == nil or hi == nil then return end
    params.set(p, math.max(lo, math.min(hi, v + delta)))
    HC6_Draw()
  end
  function HC6_Tick(event)
    local now = tonumber(event.parameters['time']) or 0
    if now < HC6_NextTick then return end
    HC6_NextTick = now + 0.20
    local patch = HC6_NativeText("PatchName")
    local label = HC6_NativeText("FocusedParameterName")
    local value = HC6_NativeText("FocusedParameterValue")
    if patch ~= HC6_LastPatch or label ~= HC6_LastFocused or value ~= HC6_LastFocusValue then
      HC6_LastPatch, HC6_LastFocused, HC6_LastFocusValue = patch, label, value
    end
    if HC6_Mode == "home" then HC6_Draw() end
  end
  function HC6_Init()
    -- Wrap only the four existing Lua entry points. No DOM reparenting,
    -- no native Osirus control IDs/handlers altered, no new onframe handler.
    local previousBank = HC_R_Bank
    HC_R_Bank = function(delta) HC6_MenuStep(delta) end
    local previousValue = HC_R_Value
    HC_R_Value = function(delta) HC6_Adjust(delta, previousValue) end
    local previousEdit = HC_R_ToggleEdit
    HC_R_ToggleEdit = function(group, led)
      previousEdit(group, led)
      -- The main EDIT button cycles the categories without a dedicated
      -- hardware edit key: PATCH / AMP / MOD MATRIX / PART.
      if group == "general" then
        local categories = {"PATCH", "AMP", "MOD MATRIX", "PART"}
        local index = 0
        if HC6_Mode == "menu" then
          for i = 1, #categories do
            if HC6_Group == categories[i] then index = i; break end
          end
        end
        HC6_OpenMenu(categories[(index % #categories) + 1])
        HC_R_SetLed(led, true)
        return
      end
      local mapping = {
        system = "SYSTEM", osc = "OSC", filter = "FILTER",
        lfo = "LFO", fx = "EFFECTS", delay = "DELAY/REV", arp = "ARP"
      }
      local section = mapping[group]
      if section ~= nil and HC6_Mode == "menu" and HC6_Group == section then
        HC6_Mode = "home"
        if HC6_Listener ~= nil then
          params.removeListener(HC6_Listener)
          HC6_Listener = nil
        end
        HC6_Draw()
        HC_R_SetLed(led, false)
      else
        HC6_OpenMenu(section or "PATCH")
        HC_R_SetLed(led, true)
      end
    end
    local previousFrame = HC5_Frame
    HC5_Frame = function(event)
      if previousFrame ~= nil then previousFrame(event) end
      HC6_Tick(event)
    end
    params.onPartChanged(function()
      HC6_Draw()
    end)
    HC6_LastPatch = HC6_NativeText("PatchName")
    HC6_LastFocused = HC6_NativeText("FocusedParameterName")
    HC6_LastFocusValue = HC6_NativeText("FocusedParameterValue")
    HC6_Draw()
  end
</script>
<!-- HC6_LCD_SCRIPT_END -->
<!-- HC7_LCD_SCRIPT_BEGIN: Replace v6 text rasterization only. -->
<script>
  -- 16 x 2 physical Virus C-style dot-matrix character layout.
  -- The existing HC6_Draw, menu/page navigation, knobs and params stay untouched.
  local HC7_PreviousLCDText = HC6_Text
  function HC6_Text(id, value)
    if id ~= "HC6_LcdTop" and id ~= "HC6_LcdBottom" then
      return HC7_PreviousLCDText(id, value)
    end
    local display = document:GetElementById(id)
    if display == nil then return end
    local s = HC6_Clean(value or "")
    s = s:gsub("ä", "ae"):gsub("ö", "oe"):gsub("ü", "ue")
         :gsub("Ä", "Ae"):gsub("Ö", "Oe"):gsub("Ü", "Ue")
         :gsub("ß", "ss"):gsub("↓", "v"):gsub("↑", "^")
    -- A full hardware character grid, 16 columns. Overflow is marked by >.
    if #s > 16 then s = string.sub(s, 1, 15) .. ">" end
    local bits = {}
    for col=1,16 do
      local c = string.byte(s, col) or 32
      if c < 32 or c > 126 then c=63 end
      bits[#bits+1] = string.format(
        '<img sprite="HC7_chr%d" style="position:absolute;left:%ddp;top:0dp;width:18dp;height:27dp;pointer-events:none;"/>',
        c, (col-1)*22)
    end
    display.inner_rml = table.concat(bits)
  end
</script>
<!-- HC7_LCD_SCRIPT_END -->
</head>
